<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/trade_spot_content_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fill_1"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fill_1"
        app:elevation="@dimen/global_appbar_elevation">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="enterAlways|scroll|snap">

            <RelativeLayout
                android:id="@+id/rl_header"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical">
                <com.chainup.kit.views.KKCommonTabKit
                    android:id="@+id/tab_trade_type"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_30"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginTop="4dp" />


                <LinearLayout
                    android:id="@+id/ll_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_28"
                    android:visibility="gone"
                    android:layout_centerInParent="true"
                    android:layout_marginLeft="@dimen/dp_15"
                    android:layout_marginRight="@dimen/dp_15"
                    android:padding="@dimen/dp_2"
                    android:background="@drawable/bg_btn_lines"
                    android:orientation="horizontal">

                    <com.coorchice.library.SuperTextView
                        android:id="@+id/btn_bb"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/mainTab_text_transaction"
                        style="@style/textstyle_dm_14_color1"
                        android:textColor="@color/text_color_1"
                        android:textSize="@dimen/sp_14"
                        app:stv_corner="@dimen/dp_4"
                        app:stv_left_bottom_corner="true"
                        app:stv_left_top_corner="true"
                        app:stv_right_bottom_corner="true"
                        app:stv_right_top_corner="true"
                        app:stv_solid="@color/fill_bg_3"
                        app:stv_stroke_color="@color/line_color"
                        app:stv_stroke_width="@dimen/dp_zero" />

                    <com.coorchice.library.SuperTextView
                        android:id="@+id/btn_grid"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/quant_grid_title"
                        style="@style/textstyle_dm_14_color1"
                        android:textColor="@color/normal_text_color"
                        android:textSize="@dimen/sp_14"
                        app:stv_corner="@dimen/dp_4"
                        app:stv_left_bottom_corner="true"
                        app:stv_left_top_corner="true"
                        app:stv_right_bottom_corner="true"
                        app:stv_right_top_corner="true"
                        app:stv_stroke_color="@color/line_color"
                        app:stv_stroke_width="@dimen/dp_zero" />

                    <com.coorchice.library.SuperTextView
                        android:id="@+id/btn_lever"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/leverage_text_leverage"
                        style="@style/textstyle_dm_14_color1"
                        android:textColor="@color/normal_text_color"
                        android:textSize="@dimen/sp_14"
                        app:stv_corner="@dimen/dp_4"
                        app:stv_left_bottom_corner="true"
                        app:stv_left_top_corner="true"
                        app:stv_right_bottom_corner="true"
                        app:stv_right_top_corner="true"
                        app:stv_stroke_color="@color/line_color"
                        app:stv_stroke_width="@dimen/dp_zero" />

                    <com.coorchice.library.SuperTextView
                        android:id="@+id/btn_otc"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/mainTab_text_otc"
                        style="@style/textstyle_dm_14_color1"
                        android:textColor="@color/normal_text_color"
                        android:textSize="@dimen/sp_14"
                        app:stv_corner="@dimen/dp_4"
                        app:stv_left_bottom_corner="true"
                        app:stv_left_top_corner="true"
                        app:stv_right_bottom_corner="true"
                        app:stv_right_top_corner="true"
                        app:stv_stroke_color="@color/line_color"
                        app:stv_stroke_width="@dimen/dp_zero" />

                </LinearLayout>

            </RelativeLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>

