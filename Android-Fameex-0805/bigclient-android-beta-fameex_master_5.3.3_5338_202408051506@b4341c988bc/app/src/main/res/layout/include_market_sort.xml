<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content">

    <com.flyco.tablayout.CommonTabLayout
        android:id="@+id/stl_market_chain_type"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_28"
        android:visibility="gone"
        style="@style/ToolbarType_bar_home_tab_amin"
        app:tl_indicator_color="@color/card_bg_color_2"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:id="@+id/ll_item_titles"
        android:layout_height="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginBottom="@dimen/dp_8"
        android:layout_marginLeft="@dimen/dp_15">

        <LinearLayout
            android:id="@+id/ll_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:text="@string/home_action_coinNameTitle"
                style="@style/textStyle_value_3_12" />

            <ImageView
                android:id="@+id/iv_name_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginLeft="2dp"
                android:layout_marginBottom="2.5dp"
                android:background="@mipmap/quotes_default" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_new_price"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_toLeftOf="@+id/ll_limit"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_new_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_gravity="bottom"
                android:text="@string/home_text_dealLatestPrice"
                style="@style/textStyle_value_3_12" />

            <ImageView
                android:id="@+id/iv_new_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginLeft="2dp"
                android:layout_marginBottom="2.5dp"
                android:src="@mipmap/quotes_default" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_limit"
            android:layout_width="78dp"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/dp_15"
            android:orientation="horizontal"
            android:gravity="right"
            android:layout_marginLeft="28dp"
            android:layout_alignParentRight="true"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/ll_new_price">


            <TextView
                android:id="@+id/tv_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:text="@string/common_text_priceLimit"
                style="@style/textStyle_value_3_12" />

            <ImageView
                android:id="@+id/iv_new_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginLeft="2dp"
                android:layout_marginBottom="2.5dp"
                android:src="@mipmap/quotes_default" />
        </LinearLayout>

    </RelativeLayout>
</LinearLayout>