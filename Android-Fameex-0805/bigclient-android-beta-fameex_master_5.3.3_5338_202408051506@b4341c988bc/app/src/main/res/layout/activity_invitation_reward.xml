<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card_color"
    android:orientation="vertical">

    <com.chainup.kit.views.PublicHeaderKit
        android:id="@+id/v_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/referral_inviteRewards_title" />

    <com.flyco.tablayout.SlidingTabLayout
        android:id="@+id/stl_invitation_loop"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:tl_tab_vertical_gravity="Bottom"
        app:tl_tab_padding="@dimen/dp_16"
        app:tl_indicator_height="@dimen/dp_4"
        app:tl_indicator_color="@color/main_color"
        app:tl_indicator_width="@dimen/dp_22"
        app:tl_textSelectColor="@color/text_color_1"
        app:tl_textUnSelectColor="@color/text_color_2"
        app:tl_textUnSelectSize="@dimen/sp_14"
        app:tl_textSelectSize="@dimen/sp_14"
        />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_half"
        android:background="@color/new_line" />

    <com.yjkj.chainup.new_version.view.NoScrollViewPager
        android:id="@+id/vp_invitation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rg_current_history"
        android:background="@color/bg_card_color" />


</LinearLayout>