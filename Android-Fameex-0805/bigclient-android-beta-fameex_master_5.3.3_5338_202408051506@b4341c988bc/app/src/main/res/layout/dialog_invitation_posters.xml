<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_invitation"
    android:orientation="vertical">


    <RelativeLayout
        android:layout_width="match_parent"
        android:id="@+id/rl_invitaion_title"
        android:paddingHorizontal="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="20dp"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_invitaion_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textColor="@color/text_color"
            style="@style/textstyle_dm_16_color1"/>

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text="@string/common_text_btnCancel"
            style="@style/textstyle_dm_14_color2"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/ll_share_layout_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_invitaion_title"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_15"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ll_share_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_8"
            android:layout_weight="1"
            android:background="@drawable/bg_exclusive_posters"
            android:orientation="vertical"
            android:visibility="visible">

            <com.qmuiteam.qmui.layout.QMUILinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/checkbox_invitation"
                app:qmui_radius="6dp"
                app:qmui_shadowAlpha="0.2"
                app:qmui_shadowElevation="@dimen/dp_4">


                <LinearLayout
                    android:id="@+id/ll_share_all_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/fill_2"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_share_image"
                        android:layout_width="match_parent"
                        android:layout_height="224dp"
                        android:scaleType="fitXY" />

                    <RelativeLayout
                        android:id="@+id/rl_one_image"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:background="@color/fill_2">

                        <TextView
                            android:id="@+id/tv_iphone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="7dp"
                            android:layout_marginTop="@dimen/dp_8"
                            android:layout_marginRight="@dimen/dp_6"
                            style="@style/textstyle_dr_10_color1"
                            tools:text="ssssss" />

                        <TextView
                            android:id="@+id/tv_invitation_content"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/tv_iphone"
                            android:layout_alignParentStart="true"
                            android:layout_marginLeft="7dp"
                            android:layout_marginRight="@dimen/dp_6"
                            android:layout_marginBottom="7dp"
                            android:layout_toLeftOf="@+id/tv_invitation_qr_code"
                            style="@style/textstyle_dm_10_color2"
                            android:textSize="6sp"
                            tools:text="ajsdkaslkdalksjdlaksjdlkas" />

                        <ImageView
                            android:id="@+id/tv_invitation_qr_code"
                            android:layout_width="@dimen/dp_30"
                            android:layout_height="@dimen/dp_30"
                            android:layout_alignParentRight="true"
                            android:layout_marginLeft="7dp"
                            android:layout_marginTop="@dimen/dp_8"
                            android:layout_marginRight="@dimen/dp_6"
                            android:layout_marginBottom="@dimen/dp_8" />
                    </RelativeLayout>
                </LinearLayout>
            </com.qmuiteam.qmui.layout.QMUILinearLayout>

            <CheckBox
                android:id="@+id/checkbox_invitation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@null"
                android:button="@drawable/optional_checkbox_2_style"
                android:checked="true"
                android:clickable="false" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_share_layout_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginLeft="@dimen/dp_8"
            android:layout_weight="1"
            android:background="@drawable/bg_exclusive_posters"
            android:orientation="vertical"
            android:visibility="visible">

            <com.qmuiteam.qmui.layout.QMUILinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/checkbox_invitation_2"
                app:qmui_radius="6dp"
                app:qmui_shadowAlpha="0.2"
                app:qmui_shadowElevation="@dimen/dp_4">

                <LinearLayout
                    android:id="@+id/ll_share_all_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/fill_2"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_share_image_2"
                        android:layout_width="match_parent"
                        android:layout_height="224dp"
                        android:layout_above="@+id/rl_two_image"
                        android:scaleType="fitXY" />

                    <RelativeLayout
                        android:id="@+id/rl_two_image"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:background="@color/fill_2">

                        <TextView
                            android:id="@+id/tv_iphone_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="7dp"
                            android:layout_marginTop="@dimen/dp_8"
                            android:layout_marginRight="@dimen/dp_6"
                            style="@style/textstyle_dr_10_color1"
                            tools:text="ssssss" />

                        <TextView
                            android:id="@+id/tv_invitation_content_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/tv_iphone_2"
                            android:layout_alignParentStart="true"
                            android:layout_marginLeft="7dp"
                            android:layout_marginRight="@dimen/dp_6"
                            android:layout_marginBottom="7dp"
                            android:layout_toLeftOf="@+id/tv_invitation_qr_code_2"
                            style="@style/textstyle_dm_10_color2"
                            android:textSize="6sp"
                            tools:text="ajsdkaslkdalksjdlaksjdlkas" />

                        <ImageView
                            android:id="@+id/tv_invitation_qr_code_2"
                            android:layout_width="@dimen/dp_30"
                            android:layout_height="@dimen/dp_30"
                            android:layout_alignParentRight="true"
                            android:layout_marginLeft="7dp"
                            android:layout_marginTop="@dimen/dp_8"
                            android:layout_marginRight="@dimen/dp_6"
                            android:layout_marginBottom="@dimen/dp_8" />
                    </RelativeLayout>
                </LinearLayout>
            </com.qmuiteam.qmui.layout.QMUILinearLayout>

            <CheckBox
                android:id="@+id/checkbox_invitation_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_10"
                android:background="@null"
                android:button="@drawable/optional_checkbox_2_style"
                android:clickable="false" />


        </LinearLayout>
    </LinearLayout>

    <com.yjkj.chainup.new_version.view.CommonlyUsedButton
        android:id="@+id/save_image_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_below="@+id/ll_share_layout_all"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginRight="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_30"
        app:bottonTextContent="@string/sl_str_save_image" />


</LinearLayout>