<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card_color"
    android:fitsSystemWindows="true"
    tools:context="com.yjkj.chainup.new_version.activity.CurrentEntrustFragment">

    <RelativeLayout
        android:id="@+id/rl_back_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50">

        <ImageView
            android:id="@+id/iv_back"
            style="@style/left_back_img_style" />


        <ImageView
            android:id="@+id/right_icon"
            android:layout_width="@dimen/dp_18"
            android:layout_height="@dimen/dp_18"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_15"
            android:src="@mipmap/screening"
            android:visibility="gone" />

    </RelativeLayout>

    <RadioGroup
        android:id="@+id/rg_current_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_below="@+id/rl_back_layout"
        android:layout_marginTop="@dimen/dp_6"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:button="@null"
            android:checked="true"
            android:gravity="center"
            android:paddingLeft="@dimen/dp_15"
            android:paddingRight="@dimen/dp_8"
            android:singleLine="true"
            android:text="@string/contract_text_currentEntrust"
            android:textColor="@drawable/kline_index_text_selector"
            android:textSize="@dimen/sp_28"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/rb_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:button="@null"
            android:drawablePadding="@dimen/dp_8"
            android:gravity="center"
            android:paddingLeft="@dimen/dp_8"
            android:paddingRight="@dimen/dp_20"
            android:singleLine="true"
            android:text="@string/contract_text_historyCommision"
            android:textColor="@drawable/kline_index_text_selector"
            android:textSize="@dimen/sp_16" />
    </RadioGroup>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/stl_market_type"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        app:tabIndicatorHeight="@dimen/dp_4"
        android:layout_below="@+id/rl_back_layout"
        app:tabIndicatorFullWidth="false"
        app:tabIndicator="@drawable/tab_indicator_layer"
        app:tabBackground="@color/transparent"
        app:tabRippleColor="@null"
        app:tabTextAppearance="@style/GoogleOtcTbStyle"
        app:tabMinWidth="@dimen/dp_0"
        app:tabPadding="@dimen/dp_8"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/text_color_1"
        >

    </com.google.android.material.tabs.TabLayout>


    <LinearLayout
        android:id="@+id/layout_item_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_below="@+id/stl_market_type"
        android:orientation="vertical">
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/global_divider_width"
            android:background="@color/global_divider_color" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_35"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/fl_type1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_type1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/common_action_allTradingPairs"
                    style="@style/textstyle_dm_12_color2" />
                <ImageView
                    android:id="@+id/img_type1"
                    android:layout_width="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:src="@mipmap/exchange_dropdown"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <View
                android:layout_width="@dimen/global_divider_width"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:background="@color/global_divider_color" />

            <LinearLayout
                android:id="@+id/fl_type2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_type2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/common_action_sendall"
                    style="@style/textstyle_dm_12_color2" />
                <ImageView
                    android:id="@+id/img_type2"
                    android:layout_width="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:src="@mipmap/exchange_dropdown"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <View
                android:layout_width="@dimen/global_divider_width"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:background="@color/global_divider_color" />

            <LinearLayout
                android:id="@+id/fl_type3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_type3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/common_action_alltypes"
                    style="@style/textstyle_dm_12_color2" />
                <ImageView
                    android:id="@+id/img_type3"
                    android:layout_width="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:src="@mipmap/exchange_dropdown"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <View
                android:id="@+id/v_line3"
                android:layout_width="@dimen/global_divider_width"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:background="@color/global_divider_color" />

            <FrameLayout
                android:id="@+id/fl_type4"
                android:layout_width="0dp"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/fl_type4_tv_parent"
                    android:layout_width="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tv_type4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/common_action_allstatus"
                        style="@style/textstyle_dm_12_color2" />
                    <ImageView
                        android:id="@+id/img_type4"
                        android:layout_width="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:src="@mipmap/exchange_dropdown"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>


    <com.yjkj.chainup.new_version.view.NoScrollViewPager
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/layout_item_tools"
        android:background="@color/fill_2" />


</RelativeLayout>
