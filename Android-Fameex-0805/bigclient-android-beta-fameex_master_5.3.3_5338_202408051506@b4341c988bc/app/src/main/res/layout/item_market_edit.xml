<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/ll_item_titles"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_15"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/layout_check_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="0.16"
            android:clickable="true"
            android:descendantFocusability="blocksDescendants"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/check_select"
                style="@style/OptionalCheckboxTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:layout_marginRight="@dimen/dp_8"/>

            <TextView
                android:id="@+id/tv_coin_name"
                style="@style/textStyle_title_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                tools:text="LTC" />

            <TextView
                android:id="@+id/tv_market_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:layout_marginStart="@dimen/dp_2"
                android:textColor="@color/normal_text_color"
                android:textSize="@dimen/sp_12"
                tools:text="/ETH" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.42"
            android:gravity="right">

            <ImageView
                android:id="@+id/iv_topping"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@mipmap/quotes_top"
                android:layout_marginRight="20dp"
                app:tint="@color/special_4"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.42"
            android:gravity="right">

            <ImageView
                android:id="@+id/tv_drag"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@mipmap/quotes_drag"
                app:tint="@color/special_4" />
        </LinearLayout>


    </LinearLayout>

</LinearLayout>