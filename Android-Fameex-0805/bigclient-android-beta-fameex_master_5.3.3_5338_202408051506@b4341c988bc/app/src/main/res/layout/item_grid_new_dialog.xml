<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_item_new_dialog"
    android:orientation="vertical">


    <TextView
        android:id="@+id/tv_more"
        style="@style/textStyle_title_16"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_width="wrap_content"
        android:text="@string/common_action_showMore"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_height="wrap_content"/>

    <ImageView
        android:id="@+id/ic_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:src="@mipmap/sheet_close" />

    <com.yjkj.chainup.wedegit.GridRecyclerView
        android:id="@+id/recycler_view"
        app:maxHeight="@dimen/dp_400"
        android:layout_below="@id/tv_more"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_4"
        android:layout_marginEnd="@dimen/dp_4"
        android:layout_marginBottom="@dimen/dp_32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


</RelativeLayout>