<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="300dp"
    android:background="@drawable/bg_otc_trading_dialog"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/rl_security_verification_layout"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:text="@string/common_text_tip"
            android:textColor="@color/text_color"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/dp_16"
            android:text="@string/common_text_btnCancel"
            android:textColor="@color/normal_text_color"
            android:textSize="@dimen/sp_14" />


    </RelativeLayout>

    <TextView
        android:id="@+id/tv_validation_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_16"
        android:text="@string/otcSafeAlert_text_title"
        android:textColor="@color/normal_text_color"
        android:textSize="@dimen/sp_14"
        android:layout_marginBottom="@dimen/dp_20"
        />
    <RelativeLayout
        android:id="@+id/ll_nick_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_below="@+id/tv_two_title"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_16"
        android:background="@drawable/bg_bind_google">

        <TextView
            android:id="@+id/tv_nickname_set"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/dp_15"
            android:text="去设置"
            android:textColor="@color/main_blue"
            android:textSize="@dimen/sp_14" />

        <TextView
            android:id="@+id/tv_nick_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="15dp"
            android:text="@string/otcSafeAlert_action_nickname"
            android:layout_toLeftOf="@+id/tv_nickname_set"
            android:fontFamily="@font/dinpro_medium"
            android:textColor="@color/text_color"
            android:textSize="@dimen/sp_14" />

    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_google"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_below="@+id/tv_two_title"
        android:visibility="visible"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_16"
        android:background="@drawable/bg_bind_google">

        <TextView
            android:id="@+id/tv_google"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/dp_15"
            android:text="去设置"
            android:textColor="@color/main_blue"
            android:textSize="@dimen/sp_14" />

        <TextView
            android:id="@+id/tv_ga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="15dp"
            android:layout_toLeftOf="@+id/tv_google"
            android:fontFamily="@font/dinpro_medium"
            android:text="@string/otcSafeAlert_action_bindGoogle"
            android:textColor="@color/text_color"
            android:textSize="@dimen/sp_14" />

    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/ll_trading_real_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_below="@+id/tv_two_title"
        android:layout_marginLeft="@dimen/dp_15"

        android:layout_marginRight="@dimen/dp_15"
        android:layout_marginBottom="30dp"
        android:background="@drawable/bg_bind_google">

        <TextView
            android:id="@+id/tv_realname_certification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="@dimen/dp_15"
            android:text="去设置"
            android:textColor="@color/main_blue"
            android:textSize="@dimen/sp_14" />

        <TextView
            android:id="@+id/tv_real_auth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="15dp"
            android:layout_toLeftOf="@+id/tv_realname_certification"
            android:fontFamily="@font/dinpro_medium"
            android:text="@string/otcSafeAlert_action_identify"
            android:textColor="@color/text_color"
            android:textSize="@dimen/sp_14" />

    </RelativeLayout>
</LinearLayout>