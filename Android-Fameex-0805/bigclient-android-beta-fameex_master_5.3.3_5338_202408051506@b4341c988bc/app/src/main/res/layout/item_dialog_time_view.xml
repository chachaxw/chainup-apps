<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dialog_bg_color"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:padding="@dimen/dp_16"
        android:layout_height="wrap_content" >

        <TextView
            android:id="@+id/tv_cancel_btn"
            android:layout_width="wrap_content"
            android:text="@string/cancel"
            style="@style/textstyle_dm_14_color2"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:text="@string/otc_choose_symbol"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="invisible"
            style="@style/textstyle_dm_16_color1"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tv_done_btn"
            android:layout_width="wrap_content"
            android:text="@string/common_text_btnConfirm"
            style="@style/textstyle_dm_14_bold_color_bule"
            android:layout_height="wrap_content"/>


    </LinearLayout>

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="match_parent"
        android:text="@string/common_text_allDay"
        android:gravity="center"
        android:visibility="gone"
        style="@style/textstyle_dm_12_color2"
        android:layout_height="wrap_content"/>

    <!--日期-->
    <com.yjkj.chainup.wedegit.SelectDatePricerView
        android:id="@+id/sdv_asset_top_up"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>