<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_bg_color"
    android:orientation="vertical">

    <com.chainup.kit.views.base.BaseEditTextKit
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginBottom="@dimen/dp_6"
        style="@style/etstyle_baseSearch"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:focusable="false"
        android:paddingVertical="@dimen/dp_0"
        app:kk_et_fillColor="@color/fill_3"
        />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36">

        <com.flyco.tablayout.SlidingTabLayout
            android:id="@+id/stl_market_type"
            style="@style/ToolbarType_bar_tab_one"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_gravity="start"
            android:layout_marginRight="@dimen/dp_16"
            android:visibility="visible" />
        <ImageView
            android:id="@+id/iv_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_16"
            android:visibility="gone"
            android:src="@mipmap/quotes_optional" />

    </RelativeLayout>


    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp_market"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_top_r_20_card_1"
        android:overScrollMode="never" />

</LinearLayout>