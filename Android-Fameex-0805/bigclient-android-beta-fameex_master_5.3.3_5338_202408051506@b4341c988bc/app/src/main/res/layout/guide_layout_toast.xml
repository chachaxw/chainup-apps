<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/layout_content"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <View
        android:id="@+id/view_arrow"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_15"
        android:background="@drawable/ic_public_poptop" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6dp"
        android:background="@drawable/bg_guide"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="@dimen/dp_16"
            android:paddingTop="@dimen/dp_13"
            android:paddingRight="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_13">

            <TextView
                android:id="@+id/tv_title"
                style="@style/textstyle_dm_14_color1"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/common_guide_search_hint" />
            <TextView
                android:id="@+id/tv_see"
                style="@style/textstyle_dm_12_color1"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:gravity="right"
                android:layout_marginTop="8dp"
                android:maxWidth="200dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/guide_3" />

        </LinearLayout>

    </LinearLayout>


</LinearLayout>