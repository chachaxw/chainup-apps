<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/card_bg_color_1"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/page_head_height"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/iv_edit"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/page_head_height"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:padding="@dimen/dp_15"
            android:text="@string/finish"
            style="@style/textstyle_dm_14_color1"
            android:textColor="@color/main_blue"/>

        <TextView
            android:id="@+id/tv_market_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/page_head_height"
            android:layout_marginRight="@dimen/page_head_height"
            android:drawablePadding="@dimen/dp_8"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/market_title_edit_like"
            style="@style/textstyle_dm_16_color1"/>

        <TextView
            android:id="@+id/iv_search"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/page_head_height"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:padding="@dimen/dp_15"
            android:text="@string/add"
            android:visibility="gone"
            style="@style/textstyle_dm_14_color1" />

    </RelativeLayout>

    <com.flyco.tablayout.SlidingTabLayout
        android:id="@+id/stl_market_type"
        style="@style/ToolbarType_bar_home_tab"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_36"
        android:layout_below="@+id/title_layout"
        android:layout_marginTop="@dimen/dp_4"
        android:visibility="visible"
        app:tl_indicator_color="@color/card_bg_color_2" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp_market"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/stl_market_type"
        android:layout_marginTop="-1dp"
        android:overScrollMode="never" />
</RelativeLayout>
