<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dialog_bg_color"
    app:cardCornerRadius="4dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="@string/quant_grid_guide"
            android:textColor="@color/text_color"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_20"
            android:orientation="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imageOne"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:src="@drawable/greatepolicy"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/imageTwo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:src="@drawable/policyrun"
                        android:visibility="invisible" />

                    <ImageView
                        android:id="@+id/imageThree"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:src="@drawable/policystop"
                        android:visibility="invisible" />


            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:paddingVertical="@dimen/dp_5"
            android:paddingHorizontal="@dimen/dp_8">

            <com.chainup.kit.views.KKButtonKit
                android:id="@+id/btn_know"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                app:kk_textContent="@string/alert_common_i_understand"
                android:layout_marginHorizontal="@dimen/dp_8"
                app:kk_buttonStyle="cancel"
                />
            <com.chainup.kit.views.KKButtonKit
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                app:kk_textContent="@string/common_action_next"
                android:layout_marginHorizontal="@dimen/dp_8"
                />


        </LinearLayout>


    </LinearLayout>
</androidx.cardview.widget.CardView>
