<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_15">

        <ImageView
            android:id="@+id/iv_msg_status"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tv_type_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@id/iv_msg_status"
            android:text="TextView"
            android:fontFamily="@font/dinpro_regular"
            android:textColor="@color/text_color"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            tools:text="Safety information" />
    </RelativeLayout>
    <TextView
        android:id="@+id/tv_ctime"
        android:layout_marginLeft="30dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:text="TextView"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/dinpro_medium"
        android:textColor="@color/normal_text_color"
        android:textSize="@dimen/sp_12"
        tools:text="2018-05-03 10:03:31" />

    <TextView
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="28dp"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginRight="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_15"
        android:fontFamily="@font/dinpro_regular"
        android:text="TextView"
        android:lineSpacingExtra="5dp"
        android:textColor="@color/normal_text_color"
        android:textSize="@dimen/sp_14"
        tools:text="Dear user, your real name authen your real your real Dear user, your real name authen your real your real " />

    <View style="@style/common_horizon_line_style"
        android:layout_marginLeft="@dimen/dp_15"/>

</LinearLayout>