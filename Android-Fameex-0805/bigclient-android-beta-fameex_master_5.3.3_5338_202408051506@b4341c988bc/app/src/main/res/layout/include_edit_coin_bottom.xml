<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:gravity="center"
    android:background="@color/fill_9"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_item_titles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dp_15"
        android:paddingRight="@dimen/dp_15">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.78"
            android:gravity="left|center_vertical">

            <LinearLayout
                android:id="@+id/ll_item_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:descendantFocusability="beforeDescendants"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/check_select_all"
                    style="@style/OptionalCheckboxTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp_8"
                    android:clickable="false"
                    android:enabled="true"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/tv_all"
                    style="@style/textstyle_dm_14_color1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:gravity="left"
                    android:text="@string/otc_all" />
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_item_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:descendantFocusability="blocksDescendants"
            android:gravity="right|center_vertical">

            <ImageView
                android:id="@+id/iv_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp_8"
                android:clickable="false"
                android:src="@mipmap/public_delete_default" />

            <TextView
                android:id="@+id/tv_delete"
                style="@style/textstyle_dm_14_color1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:gravity="center|right"
                android:text="@string/delete"
                android:textColor="@color/text_color_2" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>