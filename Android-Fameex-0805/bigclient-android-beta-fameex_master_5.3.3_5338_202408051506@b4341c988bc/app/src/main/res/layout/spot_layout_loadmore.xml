<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!--加载中-->
    <RelativeLayout
        android:id="@+id/view_loading"
        android:layout_width="match_parent"
        android:visibility="visible"
        tools:visibility="visible"
        android:layout_height="@dimen/dp_40">

        <ProgressBar
            android:id="@+id/pb_load"
            style="?android:attr/progressBarStyle"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_toLeftOf="@id/tv_cp_loadmore_loading"
            android:indeterminateTint="@color/main_color"
            android:layout_centerVertical="true"
            />

        <TextView
            android:id="@+id/tv_cp_loadmore_loading"
            style="@style/textstyle_dm_12_color2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cp_loadmore_loading"
            android:layout_centerInParent="true"
            android:layout_marginLeft="@dimen/dp_10"
            />
    </RelativeLayout>

    <!--加载完成-->
    <RelativeLayout
        android:visibility="gone"
        tools:visibility="visible"
        android:id="@+id/view_loadComplete"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40">

        <TextView
            android:id="@+id/tv_cp_loadmore_finish"
            style="@style/textstyle_dm_12_color2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginLeft="@dimen/dp_10"
            android:text="@string/cp_loadmore_finish"
            />
    </RelativeLayout>

    <!--加载结束 没有数据-->
    <RelativeLayout
        android:visibility="gone"
        tools:visibility="visible"
        android:id="@+id/view_loadEnd"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40">

        <TextView
            android:id="@+id/tv_cp_loadmore_nodata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginLeft="@dimen/dp_10"
            style="@style/textstyle_dm_12_color2"
            android:text="@string/cp_loadmore_nodata"
            />
    </RelativeLayout>

    <!--加载failed-->
    <RelativeLayout
        android:visibility="gone"
        tools:visibility="visible"
        android:id="@+id/view_loadFail"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40">
        <TextView
            android:id="@+id/tv_cp_loadmore_failed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginLeft="@dimen/dp_10"
            style="@style/textstyle_dm_12_color2"
            android:text="@string/cp_loadmore_failed"
            />
    </RelativeLayout>
</LinearLayout>
