<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card_color"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        style="@style/base_style_padd_16"
        android:layout_height="match_parent">
        <!--设置-->
        <ImageView
            android:id="@+id/ic_close"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:src="@drawable/login_close" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/ic_close"
            android:orientation="vertical">
            <!--选择语言-->

            <LinearLayout
                android:layout_width="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/dp_50"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                    android:src="@mipmap/public_scancode"
                    android:layout_height="wrap_content"/>


                <TextView
                    android:id="@+id/tv_scan_title"
                    android:layout_width="wrap_content"
                    android:text="@string/login_scan_title"
                    android:layout_marginTop="@dimen/dp_16"
                    style="@style/textStyle_title_18"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tv_scan_desc"
                    android:layout_width="wrap_content"
                    android:text="@string/login_scan_desc"
                    android:layout_marginTop="@dimen/dp_4"
                    style="@style/textStyle_value_82_12"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/dp_24"
                    android:orientation="vertical"
                    style="@style/base_style_padd_16_full"
                    android:background="@drawable/bg_etf_tips"
                    android:layout_height="wrap_content">

                    <com.yjkj.chainup.wedegit.GridTextView
                        android:id="@+id/tv_ip"
                        app:contentView=""
                        app:titleView="@string/login_scan_ipTitle"
                        app:contentSize="@dimen/sp_12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <com.yjkj.chainup.wedegit.GridTextView
                        android:id="@+id/tv_device"
                        android:layout_width="match_parent"
                        app:contentView=""
                        app:titleView="@string/login_scan_equipment"
                        app:contentSize="@dimen/sp_12"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_height="wrap_content"/>

                </LinearLayout>


            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:layout_marginBottom="@dimen/dp_54">

                <com.chainup.kit.views.KKButtonKit
                    android:id="@+id/login_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:layout_marginBottom="@dimen/dp_16"
                    app:kk_buttonText="@string/login_scan_confirm" />

                <TextView
                    android:id="@+id/login_cancal"
                    style="@style/textStyle_text_2_14_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/login_confirm"
                    android:layout_centerHorizontal="true"
                    android:text="@string/login_scan_cancel" />
            </RelativeLayout>
        </LinearLayout>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>