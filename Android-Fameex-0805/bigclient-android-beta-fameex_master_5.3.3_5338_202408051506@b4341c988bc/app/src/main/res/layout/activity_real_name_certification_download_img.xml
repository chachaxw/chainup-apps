<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <com.chainup.kit.views.PublicHeaderKit
        android:id="@+id/v_head"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        app:title="@string/kyc_page_name"
        app:isShowRightBtn="false"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:background="@color/bg_card_color"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/v_head"
        android:background="@color/bg_card_color"
        >
        <androidx.core.widget.NestedScrollView
            android:id="@+id/v_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_common_action_uploadFrontView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/common_action_uploadFrontView"
                    style="@style/textstyle_dm_12_color1"
                    />

                <RelativeLayout
                    android:layout_width="240dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="@dimen/dp_10">

                    <ImageView
                        android:id="@+id/iv_frist"
                        android:layout_width="240dp"
                        android:layout_height="140dp"
                        android:src="@mipmap/personal_positiveupload" />

                    <LinearLayout
                        android:id="@+id/ll_frist_reset"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_reset_sfz"
                        android:gravity="center"
                        android:visibility="gone"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/personal_upload" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/personal_Center_text31"
                            android:textColor="@color/main_blue"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_frist_close"
                        android:layout_width="@dimen/dp_30"
                        android:layout_height="@dimen/dp_30"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/personal_delete_certification"
                        android:visibility="gone" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tv_common_action_uploadBackView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_30"
                    android:text="@string/common_action_uploadBackView"
                    style="@style/textstyle_dm_12_color1"
                    />

                <RelativeLayout
                    android:layout_width="240dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="@dimen/dp_10">

                    <ImageView
                        android:id="@+id/iv_second"
                        android:layout_width="240dp"
                        android:layout_height="140dp"
                        android:src="@mipmap/personal_uploadreverse" />
                    <LinearLayout
                        android:id="@+id/ll_second_reset"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_reset_sfz"
                        android:gravity="center"
                        android:visibility="gone"

                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/personal_upload" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/personal_Center_text31"
                            android:textColor="@color/main_blue"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_second_close"
                        android:layout_width="@dimen/dp_30"
                        android:layout_height="@dimen/dp_30"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/personal_delete_certification"
                        android:visibility="gone" />
                </RelativeLayout>


                <TextView
                    android:id="@+id/tv_common_action_uplodadIdInHand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_30"
                    android:text="@string/common_action_uplodadIdInHand"
                    style="@style/textstyle_dm_12_color1"
                    />

                <RelativeLayout
                    android:layout_width="240dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="@dimen/dp_10">

                    <ImageView
                        android:id="@+id/iv_third"
                        android:layout_width="240dp"
                        android:layout_height="140dp"
                        android:src="@mipmap/personal_handhelddocuments" />
                    <LinearLayout
                        android:id="@+id/ll_third_reset"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_reset_sfz"
                        android:gravity="center"
                        android:visibility="gone"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/personal_upload" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/personal_Center_text31"
                            android:textColor="@color/main_blue"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_third_close"
                        android:layout_width="@dimen/dp_30"
                        android:layout_height="@dimen/dp_30"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/personal_delete_certification"
                        android:visibility="gone" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tv_common_tip_uploadImgRequire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_15"
                    android:layout_marginTop="@dimen/dp_30"
                    android:layout_marginBottom="4dp"
                    android:layout_gravity="left"
                    android:text="@string/common_tip_uploadImgRequire"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/sp_14" />

                <TextView
                    android:id="@+id/tv_kyc_explain_photoTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_15"
                    android:layout_marginRight="@dimen/dp_15"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/kyc_explain_photoTip"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/sp_12" />

                <TextView
                    android:id="@+id/tv_4_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_15"
                    android:layout_marginRight="@dimen/dp_15"
                    android:visibility="gone"
                    android:lineSpacingExtra="6dp"
                    android:layout_marginTop="@dimen/dp_5"
                    android:text="@string/kyc_explain_lastTip"
                    android:textColor="@color/text_3"
                    android:textSize="@dimen/sp_12" />
                <com.yjkj.chainup.new_version.view.CommonlyUsedButton
                    android:id="@+id/cub_next"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:layout_marginLeft="@dimen/dp_15"
                    android:layout_marginTop="@dimen/dp_30"
                    android:layout_marginBottom="@dimen/dp_50"
                    android:layout_marginRight="@dimen/dp_15"
                    app:bottonTextContent="@string/common_action_next" />


            </LinearLayout>


        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</RelativeLayout>