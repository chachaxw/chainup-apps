<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="@dimen/dp_16"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_history_grid_execute"
            style="@style/textstyle_dm_16_color1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quant_ordering" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="4dp"
            android:layout_marginTop="8.5dp"
            android:background="@color/main_1" />
    </LinearLayout>

    <ImageView
        android:id="@+id/tv_history_grid_title"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_12"
        android:scaleType="fitCenter"
        android:src="@mipmap/public_icon_order" />

    <RadioButton
        android:id="@+id/tv_history_grid_current"
        style="@style/textStyle_title_14_rb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_20"
        android:layout_toLeftOf="@id/tv_history_grid_title"
        android:checked="true"
        android:drawableLeft="@drawable/bg_complaint"
        android:drawablePadding="@dimen/dp_8"
        android:text="@string/quant_hide_otherSymbol"
        android:textColor="@color/text_color"
        android:textSize="@dimen/sp_14"
        android:visibility="gone" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"
        android:src="@color/line_color" />
</RelativeLayout>




