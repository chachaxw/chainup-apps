<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_item_new_dialog"
    android:paddingHorizontal="@dimen/dp_16"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/rl_security_verification_layout"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_action_fogetpwdSafety"
            android:textColor="@color/text_color"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_security_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text="@string/common_text_btnCancel"
            android:textColor="@color/normal_text_color"
            android:textSize="@dimen/sp_14" />


    </RelativeLayout>




<!--    手机验证-->
    <RelativeLayout
        android:id="@+id/rl_phone_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:tag="@string/security_phone"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_phone_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/textstyle_dm_14_color1"
            tools:text="123456789"
            />

        <com.yjkj.chainup.new_version.view.ComVerifyView
            android:id="@+id/cv_content_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_phone_title"
            android:layout_marginTop="@dimen/dp_15"
            app:verify_type="1"
            app:verify_type_size="14sp"
            app:textHint="@string/toast_no_mobile_verification_code"
            />
    </RelativeLayout>

    <!--    邮箱验证-->
    <RelativeLayout
        android:id="@+id/rl_mail_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:tag="@string/security_email"
        android:visibility="gone"
        tools:visibility="visible"
        >

        <TextView
            android:id="@+id/tv_mail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/textstyle_dm_14_color1"
            tools:text="xxx@gmail.com"
            />

        <com.yjkj.chainup.new_version.view.ComVerifyView
            android:id="@+id/cv_content_mail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_mail_title"
            android:layout_marginTop="@dimen/dp_14"
            app:verify_type="-1"
            app:verify_type_size="14sp"
            app:textHint="@string/personal_tip_inputMailCode"
            />
    </RelativeLayout>

<!--    Google 验证-->
    <RelativeLayout
        android:id="@+id/rl_google_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:tag="@string/security_google"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_google_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/textstyle_dm_14_color1"
            android:text="@string/personal_text_googleCode"
            />

        <com.yjkj.chainup.new_version.view.ComVerifyView
            android:id="@+id/cv_content_google"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_google_title"
            android:layout_marginTop="@dimen/dp_15"
            app:verify_type_size="14sp"
            app:textHint="@string/common_tip_googleAuth"
            />
    </RelativeLayout>


    <!-- 资金密码验证-->
    <RelativeLayout
        android:id="@+id/rl_capital_pwd_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:visibility="gone"
        tools:visibility="visible"
        android:tag="@string/security_capital_pwd">

        <TextView
            android:id="@+id/tv_capital_pwd_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/otcSafeAlert_text_otcPwd"
            style="@style/textstyle_dm_14_color1"
            android:layout_alignParentTop="true"
            />


        <com.yjkj.chainup.new_version.view.PwdSettingView
            android:id="@+id/pwd_capital_pwd"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_below="@id/tv_capital_pwd_title"
            android:textCursorDrawable="@drawable/et_cursor_color"
            app:hint_text="@string/register_tip_inputPassword"
            app:isEditable="true"
            app:textContent="" />

    </RelativeLayout>

    <!-- 登录密码验证-->
    <RelativeLayout
        android:id="@+id/rl_pwd_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_30"
        android:visibility="gone"
        tools:visibility="visible"
        android:tag="@string/security_login_pwd">

        <TextView
            android:id="@+id/tv_pwd_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_text_loginPwd"
            style="@style/textstyle_dm_14_color1"
            android:layout_alignParentTop="true"
            />


        <com.yjkj.chainup.new_version.view.PwdSettingView
            android:id="@+id/pwd_login_pwd"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_below="@+id/tv_pwd_title"
            android:textCursorDrawable="@drawable/et_cursor_color"
            app:hint_text="@string/register_tip_inputPassword"
            app:isEditable="true"
            app:textContent="" />
    </RelativeLayout>

    <com.chainup.kit.views.KKButtonKit
        android:id="@+id/tv_confirm"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_30"
        android:layout_marginBottom="@dimen/dp_30"
        app:kk_buttonText="@string/common_text_btnConfirm" />

</LinearLayout>