<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card_color"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".new_version.activity.personalCenter.SafetySettingActivity">

    <com.yjkj.chainup.new_version.view.PersonalCenterView
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card_color"
        app:personalTitle="@string/personal_text_safetycenter"
        app:showRightIc="false" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tv_safe_level_label"
                    android:layout_width="wrap_content"
                    android:text="@string/personal_Center_text7"
                    android:layout_marginLeft="16dp"
                    android:textColor="@color/normal_text_color"
                    android:textSize="14sp"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tv_level"
                    android:layout_width="wrap_content"
                    android:text="低"
                    android:layout_marginLeft="8dp"
                    android:textColor="@color/main_red"
                    android:textSize="14sp"
                    android:layout_height="wrap_content"/>

            </LinearLayout>
            <com.yjkj.chainup.new_version.view.ZProgressBar
                android:id="@+id/pb_level"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:max="100"
                android:progress="0"
                app:zpb_backgroundColor="@color/card_bg_color_2"
                app:zpb_duration="300"
                app:zpb_progressColor="@color/main_blue"
                app:zpb_radius="2dp"/>
            <!--手机-->
            <com.yjkj.chainup.new_version.view.AccountItemView
                android:id="@+id/rl_phone"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/bg_card_color"
                app:StatusText="@string/personal_text_safeSettingOpen"
                app:isShowLeftIcon="false"
                app:showLine="false"
                android:layout_marginTop="10dp"
                app:itemTitle="@string/register_text_phone"
                app:showIcon="false" />
            <!--邮箱-->
            <com.yjkj.chainup.new_version.view.AccountItemView
                android:id="@+id/rl_email"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/bg_card_color"
                app:StatusText="@string/personal_text_safeSettingOpen"
                app:isShowLeftIcon="false"
                app:showLine="false"
                app:itemTitle="@string/register_text_mail"
                app:showIcon="false" />



            <!--谷歌-->
            <com.yjkj.chainup.new_version.view.AccountItemView
                android:id="@+id/rl_google_verify"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/bg_card_color"
                app:StatusText="@string/close_verify"
                app:isShowLeftIcon="false"
                app:itemTitle="@string/safety_text_googleAuth"
                app:showIcon="false"
                app:showLine="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@color/line_color" />
            <!--修改密码-->
            <com.yjkj.chainup.new_version.view.AccountItemView
                android:id="@+id/rl_change_pwd"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/bg_card_color"
                app:StatusText="@string/filter_action_reset_change_loginpwd"
                app:isShowLeftIcon="false"
                app:itemTitle="@string/register_text_loginPwd"
                app:showIcon="false"
                app:showLine="false"/>
            <!--修改资金密码-->
            <com.yjkj.chainup.new_version.view.AccountItemView
                android:id="@+id/rl_fund_pwd"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/bg_card_color"
                app:StatusText="@string/filter_action_reset"
                app:isShowLeftIcon="false"
                app:itemTitle="@string/otc_text_pwd_forotc"
                app:showIcon="false"
                app:showLine="false" />
            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="8dp"
                android:background="@color/line_color" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_card_color"
                tools:visibility="visible"
                android:paddingVertical="@dimen/dp_12">

                <TextView
                    android:id="@+id/tv_white_list_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_12"
                    android:text="@string/safety_withdrawalWhitelist"
                    android:textColor="@color/text_color"
                    android:textSize="@dimen/sp_16"
                    style="@style/textStyle_title_16"
                    />
                <TextView
                    android:id="@+id/tv_white_list_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_12"
                    android:text="@string/safety_withdrawalWhitelist_tips"
                    style="@style/textstyle_dr_10_color2"
                    android:layout_below="@id/tv_white_list_title"
                    android:layout_marginTop="@dimen/dp_4"
                    android:layout_toLeftOf="@id/ctrl_white_list"
                    android:layout_alignParentLeft="true"
                    />

                <Switch
                    android:id="@+id/ctrl_white_list"
                    android:layout_width="@dimen/dp_35"
                    android:layout_height="@dimen/dp_18"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/dp_15"
                    android:button="@drawable/public_switch_selector"
                    android:thumb="@drawable/icon_switch_default"
                    android:track="@drawable/icon_switch_default"
                    />
            </RelativeLayout>

            <!--手势密码-->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/bg_card_color"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_safety_text_gesturePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/dp_12"
                    android:text="@string/safety_text_gesturePassword"
                    android:textColor="@color/text_color"
                    android:textSize="@dimen/sp_16"
                    style="@style/textStyle_title_16"
                    />

                <Switch
                    android:id="@+id/switch_gesture_pwd"
                    android:layout_width="@dimen/dp_35"
                    android:layout_height="@dimen/dp_18"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/dp_15"
                    android:button="@drawable/public_switch_selector"
                    android:thumb="@drawable/icon_switch_default"
                    android:track="@drawable/icon_switch_default" />
            </RelativeLayout>

            <!--指纹密码-->
            <RelativeLayout
                android:id="@+id/rl_fingerprint"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/bg_card_color"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_login_text_fingerprint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="@dimen/dp_12"
                    android:text="@string/login_text_fingerprint"
                    android:textColor="@color/text_color"
                    style="@style/textStyle_title_16"
                    android:textSize="@dimen/sp_16" />

                <Switch
                    android:id="@+id/switch_fingerprint_pwd"
                    android:layout_width="@dimen/dp_35"
                    android:layout_height="@dimen/dp_18"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/dp_15"
                    android:button="@drawable/public_switch_selector"
                    android:thumb="@drawable/icon_switch_default"
                    android:track="@drawable/icon_switch_default" />
            </RelativeLayout>

            <com.yjkj.chainup.new_version.view.AccountItemView
                android:id="@+id/rl_account_destory"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/bg_card_color"
                app:isShowLeftIcon="false"
                app:showLine="false"
                app:itemTitle="@string/account_destory_text1"
                app:showIcon="false"
                />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>