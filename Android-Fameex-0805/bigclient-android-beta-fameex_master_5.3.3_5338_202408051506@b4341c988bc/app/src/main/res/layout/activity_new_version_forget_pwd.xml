<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/v_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card_color"
    android:fitsSystemWindows="true">

    <com.chainup.kit.views.PublicHeaderKit
        android:id="@+id/v_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        app:isShowRightBtn="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/login_action_fogotPassword" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_header">

        <LinearLayout
            android:id="@+id/ll_tip"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_alignParentTop="true"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="@color/text_yellow_10_color"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:src="@mipmap/public_point"
                android:layout_marginRight="8dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                />
            <TextView
                android:id="@+id/tv_sub_title"
                style="@style/textstyle_dm_12_color1"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/password_reset_tips"
                android:textColor="@color/text_yellow_color" />
        </LinearLayout>

        <com.chainup.kit.views.KKEditFormGroupKit
            android:id="@+id/cet_view"
            style="@style/etstyle_baseFormGroup"
            android:layout_width="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_tip"
            app:kk_hint="@string/common_tip_inputPhoneOrMail"
            app:kk_title="@string/userinfo_text_account"
            android:layout_marginTop="@dimen/dp_32" />

        <com.chainup.kit.views.KKButtonKit
            android:id="@+id/cubtn_view"
            style="@style/NewVersionCommonlyUsedButtonStyle"
            android:layout_below="@+id/cet_view"
            android:layout_marginTop="@dimen/dp_28"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:kk_buttonText="@string/common_action_next"
            />


    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>