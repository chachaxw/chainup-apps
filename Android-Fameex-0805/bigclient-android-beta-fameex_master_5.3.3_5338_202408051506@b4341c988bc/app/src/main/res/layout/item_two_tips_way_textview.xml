<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_title"
        style="@style/BorrowingReturnTitleStyleNew"
        tools:text="sssssssssss" />



    <TextView
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:textColor="@color/main_blue"
        android:layout_toStartOf="@+id/tv_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:padding="@dimen/dp_4"
        android:text="@string/common_text_already_trust"
        style="@style/textStyle_green_11"
        android:layout_marginEnd="@dimen/dp_6"
        android:paddingTop="@dimen/dp_2"
        android:paddingBottom="@dimen/dp_2"
        android:textSize="@dimen/sp_10"
        android:background="@drawable/bg_tag_bead"
        tools:text="dddd" />

    <TextView
        android:id="@+id/tv_content"
        style="@style/BorrowingReturnContentStyleNew"
        android:layout_marginEnd="@dimen/dp_5"
        android:gravity="end"
        tools:text="dddddddddd" />
</RelativeLayout>