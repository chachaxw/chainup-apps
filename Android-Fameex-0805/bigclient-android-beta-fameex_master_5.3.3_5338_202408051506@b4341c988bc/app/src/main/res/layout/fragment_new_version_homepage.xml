<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fill_1"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">
        <!--header-->
        <include
            android:id="@+id/home_header"
            layout="@layout/activity_home_title" />

        <!--网络错误提示布局-->
        <RelativeLayout
            android:id="@+id/net_wrong"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:background="@color/main_red"
            android:visibility="gone">

            <ImageView
                android:id="@+id/no_network_remind"
                android:layout_width="@dimen/dp_14"
                android:layout_height="@dimen/dp_14"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_5"
                android:src="@mipmap/remind" />

            <TextView
                android:id="@+id/tv_network"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/no_network_enter"
                android:layout_toRightOf="@+id/no_network_remind"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/check_network_error_settings"
                android:textColor="@color/white" />

            <ImageView
                android:id="@+id/no_network_enter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/dp_18"
                android:src="@mipmap/nonetwork_enter" />
        </RelativeLayout>

        <!--主要内容区域-->
        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:srlEnableLoadMore="false"
            android:layout_weight="1"
            >
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/ns_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:orientation="vertical">


                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_6"
                            android:paddingLeft="@dimen/dp_16"
                            android:paddingRight="@dimen/dp_16">

                            <com.youth.banner.Banner
                                android:id="@+id/banner_looper"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp_132"
                                app:banner_indicator_height="2dp"
                                app:banner_indicator_margin="6dp"
                                app:banner_indicator_marginBottom="@dimen/dp_8"
                                app:banner_indicator_marginRight="@dimen/dp_12"
                                app:banner_indicator_normal_color="#5D6D89"
                                app:banner_indicator_normal_width="@dimen/dp_6"
                                app:banner_indicator_selected_color="#D8e1F0"
                                app:banner_indicator_selected_width="@dimen/dp_10"
                                app:banner_indicator_space="@dimen/dp_6"
                                app:banner_radius="@dimen/dp_8" />


                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/ll_advertising_layout"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dp_44"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_advertising"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="@dimen/dp_16"
                                android:background="@mipmap/home_announcement" />

                            <com.yjkj.chainup.wedegit.VerticalTextview4ChainUp
                                android:id="@+id/vtc_advertising"
                                style="@style/textStyle_title_12"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginLeft="@dimen/dp_8"
                                android:layout_marginRight="@dimen/dp_16"
                                android:layout_weight="1" />

                            <ImageView
                                android:id="@+id/iv_nation_more"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/dp_16"
                                android:layout_gravity="center_vertical"
                                android:scaleType="centerInside"
                                android:src="@mipmap/home_more" />

                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/center_app_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_top_r_20_card_1"
                            android:paddingTop="@dimen/dp_16"
                            android:orientation="vertical">

                            <RelativeLayout
                                android:id="@+id/recycler_center_service_layout"
                                style="@style/base_style_padd_20"
                                android:paddingTop="@dimen/dp_0"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/recycler_center_service"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content" />

                            </RelativeLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recycler_other_service"
                                style="@style/base_style_16"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dp_70"
                                android:scrollbars="none" />

                            <LinearLayout
                                android:id="@+id/layout_top_24"
                                style="@style/base_style_16"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/recycler_top_24"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="@dimen/dp_20"
                                    android:visibility="gone"
                                    />

                            </LinearLayout>


                            <include
                                android:id="@+id/no_network_bottom_vp"
                                layout="@layout/no_network_remind"
                                android:visibility="gone" />


                            <LinearLayout
                                android:id="@+id/bottom_vp_linearlayout"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <com.flyco.tablayout.SlidingTabLayout
                                    android:id="@+id/stl_homepage_list"
                                    style="@style/ToolbarType_bar_home_tab"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/dp_28"
                                    />


                                <com.yjkj.chainup.wedegit.WrapContentViewPager
                                    android:id="@+id/fragment_market"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:overScrollMode="never" />
                            </LinearLayout>


                        </LinearLayout>

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
                <include
                    android:id="@+id/rl_red_envelope_entranc_layout"
                    layout="@layout/redpackage_item_view"

                    />
            </RelativeLayout>

        </com.scwang.smart.refresh.layout.SmartRefreshLayout>
        <!--底部未登录 红包 布局提示-->
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:background="@android:color/transparent"
            android:layout_height="wrap_content">



            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card_bg_color_1"
                >
                <RelativeLayout
                    android:id="@+id/rl_login_tips_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_56"
                    android:layout_alignParentBottom="true"
                    android:clickable="true"
                    android:focusable="false"
                    android:background="@drawable/bg_btn_radius_login"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/tv_login_tips"
                        style="@style/textStyle_title_14_zero"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_toLeftOf="@id/tv_go_register"
                        android:layout_alignParentLeft="true"
                        android:paddingRight="@dimen/dp_10"
                        android:text="@string/login_bottom_tips" />

                    <TextView
                        android:id="@+id/tv_go_register"
                        style="@style/textStyle_title_12_zero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/dp_20"
                        android:layout_toLeftOf="@id/tv_go_login"
                        android:text="@string/register" />

                    <TextView
                        android:id="@+id/tv_go_login"
                        style="@style/textStyle_login_12"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_32"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/dp_16"
                        android:background="@drawable/bg_btn_login"
                        android:gravity="center_vertical"
                        android:text="@string/login_action_login" />

                </RelativeLayout>
            </FrameLayout>


        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/v_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
    </LinearLayout>

</FrameLayout>