<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fill_2"
    android:fitsSystemWindows="true"
    tools:context=".quickBuyCoin.QuickBuyCoinIndexActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.chainup.kit.views.PublicHeaderKit
            android:id="@+id/v_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            app:title="@string/creditCard_text4"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_provider"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:itemCount="5"
            tools:listitem="@layout/item_select_service_provider"
            />
    </LinearLayout>

</RelativeLayout>