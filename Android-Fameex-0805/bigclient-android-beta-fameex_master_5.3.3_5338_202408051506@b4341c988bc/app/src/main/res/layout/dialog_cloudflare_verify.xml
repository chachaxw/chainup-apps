<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/public_bg_dialog_corner12"
    android:paddingHorizontal="@dimen/dp_15"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/v_title"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            style="@style/textstyle_dm_16_color1"
            android:text="请完成验证"
            android:layout_alignParentLeft="true"
            android:layout_height="wrap_content"
            />

        <ImageView
            android:id="@+id/imClose"
            android:layout_width="@dimen/dp_16"
            android:layout_alignParentRight="true"
            android:src="@mipmap/public_close"
            android:layout_centerVertical="true"
            android:layout_height="@dimen/dp_16"
            app:tint="@color/text_2"
            />
    </RelativeLayout>

    <com.qmuiteam.qmui.layout.QMUIFrameLayout
        android:id="@+id/qf_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_below="@id/v_title"
        android:layout_marginBottom="@dimen/dp_20"
        app:qmui_radius="@dimen/dp_5"
        app:qmui_borderWidth="@dimen/dp_1">
        <com.yjkj.chainup.new_version.view.CloudFlareView
            android:id="@+id/cfv_verify"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="@color/card_bg_color_1"
            />
    </com.qmuiteam.qmui.layout.QMUIFrameLayout>



</RelativeLayout>
