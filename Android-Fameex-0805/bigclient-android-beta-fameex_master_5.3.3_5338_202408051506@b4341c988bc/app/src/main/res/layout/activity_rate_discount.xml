<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical">

        <com.yjkj.chainup.new_version.view.PersonalCenterView
            android:id="@+id/title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_card_color"
            app:personalTitle="@string/safety_text_phoneAuth" />


        <!--手势密码-->
        <RelativeLayout
            android:id="@+id/rl_phone_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_50"
            android:layout_marginLeft="@dimen/dp_15"
            android:layout_marginRight="@dimen/dp_15"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@color/bg_card_color"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_title_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"

                android:text="@string/personal_Center_text18"
                android:textColor="@color/text_color"
                android:textSize="@dimen/sp_14"
                android:layout_toLeftOf="@id/switch_gesture_pwd"
                android:layout_marginRight="@dimen/dp_20"
                android:layout_alignParentLeft="true"
                />
            <Switch
                android:id="@+id/switch_gesture_pwd"
                android:layout_width="@dimen/dp_35"
                android:layout_height="@dimen/dp_18"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:button="@drawable/public_switch_selector"
                android:background="@null"
                android:thumb="@drawable/icon_switch_default"
                android:track="@drawable/icon_switch_default" />

        </RelativeLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="@dimen/dp_15"
            android:layout_marginRight="@dimen/dp_15"
            android:layout_marginBottom="8dp"
            android:background="@color/line_color" />

        <TextView
            android:id="@+id/tv_tip"
            android:layout_width="wrap_content"
            android:layout_marginLeft="@dimen/dp_15"
            android:layout_marginRight="@dimen/dp_15"
            android:text="@string/personal_Center_text19"
            android:textSize="12sp"
            android:textColor="@color/normal_text_color"
            android:layout_height="wrap_content"/>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>