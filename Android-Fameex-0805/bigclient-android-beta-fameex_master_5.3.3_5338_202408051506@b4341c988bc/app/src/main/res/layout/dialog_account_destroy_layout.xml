<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dp_20"
    android:background="@drawable/public_bg_dialog_corner12">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/account_destory_text7"
        android:layout_gravity="center_horizontal"
        style="@style/app_text_dm_style"
        android:textColor="@color/text_color_1"
        android:textSize="@dimen/sp_16"
        />

    <TextView
        android:id="@+id/tv_condition1"
        android:drawableLeft="@drawable/im_complete_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:text="@string/account_destory_text8"

        style="@style/app_account_destroy_tv_condition1_style"
        />
    <TextView
        android:id="@+id/tv_condition2"
        android:drawableLeft="@drawable/im_complete_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:text="@string/account_destory_text9"
        style="@style/app_account_destroy_tv_condition1_style"
        />
    <TextView
        android:id="@+id/tv_condition3"
        android:drawableLeft="@drawable/im_complete_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:text="@string/account_destory_text10"
        style="@style/app_account_destroy_tv_condition1_style"
        />
    <TextView
        android:id="@+id/tv_condition4"
        android:drawableLeft="@drawable/im_complete_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:text="@string/account_destory_text11"
        style="@style/app_account_destroy_tv_condition1_style"
        />
    <TextView
        android:id="@+id/tv_condition5"
        android:drawableLeft="@drawable/im_complete_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:text="@string/account_destory_text12"
        style="@style/app_account_destroy_tv_condition1_style"
        />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cub_cancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_44"
            android:layout_weight="1"
            android:background="@drawable/kk_btn_2_bg"
            android:gravity="center"
            android:layout_marginRight="@dimen/dp_8"
            android:text="@string/common_text_btnCancel"
            style="@style/textstyle_dm_14_color1"
            tools:text="取消"
            />

        <com.yjkj.chainup.new_version.view.CommonlyUsedButton
            android:id="@+id/cub_confirm"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_44"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/dp_8"
            />


    </LinearLayout>

</LinearLayout>