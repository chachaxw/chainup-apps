<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical">
    <TextView
        android:id="@+id/tv_instructions_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_34"
        android:text="@string/withdraw_tip_notice"
        style="@style/textstyle_dr_14_color2"
        />

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginHorizontal="@dimen/dp_15">
        <TextView
            android:id="@+id/tv_can_use_amount_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kyc_withdrawal_amount"
            android:layout_alignParentLeft="true"
            style="@style/textstyle_dr_12_color3"
            />
        <TextView
            android:id="@+id/tv_can_use_amount_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:layout_alignParentRight="true"
            style="@style/textstyle_dr_12_color1"
            />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginHorizontal="@dimen/dp_15">
        <TextView
            android:id="@+id/tv_withdraw_amount_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kyc_withdrawal_24h"
            android:layout_alignParentLeft="true"
            style="@style/textstyle_dr_12_color3"
            />
        <TextView
            android:id="@+id/tv_withdraw_amount_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:layout_alignParentRight="true"
            style="@style/textstyle_dr_12_color1"
            />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:layout_marginHorizontal="@dimen/dp_15">
        <TextView
            android:id="@+id/tv_single_max_withdraw_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/charge_chargeAlert_contentB"
            android:layout_alignParentLeft="true"
            style="@style/textstyle_dr_12_color3"
            />
        <TextView
            android:id="@+id/tv_single_max_withdraw_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:layout_alignParentRight="true"
            style="@style/textstyle_dr_12_color1"
            />
    </RelativeLayout>
</LinearLayout>