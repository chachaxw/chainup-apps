<!--            android:background="@color/line_color" />-->


<!--        <ImageView-->
<!--            android:id="@+id/tv_add"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="40dp"-->
<!--            android:background="@color/transparent"-->
<!--            android:gravity="center"-->
<!--            android:src="@drawable/ic_baseline_add_24" />-->

        <com.chainup.kit.views.KKEditNumberKit
            android:id="@+id/et_price"
            style="@style/textstyle_dm_14_color1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_select_contract"
            android:gravity="center"
            android:hint="@string/contract_text_price"
            android:inputType="numberDecimal"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10"
            android:textColorHint="@color/text_color_3"
            android:textCursorDrawable="@drawable/cp_et_cursor_color" />

        <LinearLayout
            android:id="@+id/layout_v_tools"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_39"
            android:layout_marginTop="@dimen/dp_half"
            android:layout_marginRight="@dimen/dp_half"
            android:layout_marginBottom="@dimen/dp_1"
            android:background="@drawable/bg_add_type"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_add"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_19"
                android:paddingBottom="@dimen/dp_4"
                android:rotation="180"
                android:src="@mipmap/exchange_dropdown" />

            <ImageView
                android:id="@+id/iv_sub"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_19"
                android:paddingBottom="@dimen/dp_4"
                android:src="@mipmap/exchange_dropdown" />

        </LinearLayout>

    </LinearLayout>
    <!--折合价格-->
    <TextView
        android:id="@+id/tv_convert_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:singleLine="true"
        android:visibility="gone"
        android:text="--"
        style="@style/textStyle_text_nor_12"
        tools:text="¥37.900888888888888888888888888888" />

    <!--¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥¥-->
    <LinearLayout
        android:id="@+id/ll_volume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:background="@drawable/bg_trade_et_unfocused"
        android:orientation="vertical">


        <!--交易量-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:orientation="horizontal">
            <com.chainup.kit.views.KKEditNumberKit
                android:id="@+id/et_volume"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/cp_order_text43"
                android:gravity="center"
                android:paddingLeft="@dimen/dp_10"
                android:paddingRight="@dimen/dp_10"
                android:inputType="numberDecimal"
                android:background="@drawable/bg_select_contract"
                style="@style/textstyle_dm_14_color1"
                android:textColorHint="@color/text_color_3"
                android:textCursorDrawable="@drawable/cp_et_cursor_color"
                />

            <EditText
                style="@style/textStyle_title_14"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.65"
                android:background="@null"
                android:ellipsize="end"
                android:focusableInTouchMode="true"
                android:hint="@string/transaction_tip_buyVolume"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:paddingLeft="@dimen/dp_10"
                android:paddingRight="@dimen/dp_10"
                android:singleLine="true"
                android:textColorHint="@color/hint_color"
                android:textCursorDrawable="@drawable/et_cursor_color" />

            <com.coorchice.library.SuperTextView
                android:id="@+id/tv_coin_name"
                style="@style/textStyle_text_nor_bold_12"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical|right"
                android:paddingRight="@dimen/dp_10"
                tools:text="XRPXL" />


        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_half"
            android:layout_marginLeft="@dimen/dp_half"
            android:visibility="gone"
            android:layout_marginRight="@dimen/dp_half"
            android:background="@color/tabbar_divide_color" />

        <RadioGroup
            android:id="@+id/rg_trade"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_1st"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="25%"
                style="@style/textStyle_text_nor_bold_12"
                tools:text="25%" />

            <View
                android:layout_width="@dimen/dp_half"
                android:layout_height="match_parent"
                android:background="@color/tabbar_divide_color" />

            <RadioButton
                android:id="@+id/rb_2nd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="50%"
                style="@style/textStyle_text_nor_bold_12"
                tools:text="25%" />

            <View
                android:layout_width="@dimen/dp_half"
                android:layout_height="match_parent"
                android:background="@color/tabbar_divide_color" />

            <RadioButton
                android:id="@+id/rb_3rd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="75%"
                style="@style/textStyle_text_nor_bold_12"
                tools:text="25%" />

            <View
                android:layout_width="@dimen/dp_half"
                android:layout_height="match_parent"
                android:background="@color/tabbar_divide_color" />

            <RadioButton
                android:id="@+id/rb_4th"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="100%"
                style="@style/textStyle_text_nor_bold_12"
                tools:text="25%" />

        </RadioGroup>

    </LinearLayout>
    <com.chainup.kit.views.KKSelectRatioViewKit
        android:id="@+id/rb_trade_v2"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_height="@dimen/dp_22"/>
    <LinearLayout
        android:id="@+id/ll_transaction"
        android:layout_width="match_parent"
        android:layout_marginTop="24dp"
        android:layout_height="wrap_content">
        <com.chainup.kit.views.base.BaseEditTextKit
            android:id="@+id/tv_transaction_money"
            style="@style/BaseEditTextKitStyle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_horizontal"
            app:kk_et_fillColor="@color/card_bg_color_2"
            android:enabled="false"
            android:hint="Total (USDT)"
            android:inputType="numberDecimal" />

    </LinearLayout>
    <!--可用余额-->
    <LinearLayout
        android:id="@+id/ll_balance"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_13"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_balance_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/assets_text_available"
            style="@style/textstyle_dm_12_color2"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_available_balance"
            style="@style/textstyle_dm_12_color1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:gravity="right|center_vertical"
            android:maxLines="1"
            android:text="--"
            tools:text="可用 37.9008USDT" />

        <ImageView
            android:id="@+id/img_transfer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_4"
            android:src="@drawable/ic_public_increase"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_18"
        android:gravity="center"
        android:visibility="gone"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_transaction_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/transaction_text_tradeSum"
            android:textColor="@color/normal_text_color"
            android:textSize="@dimen/sp_14"
            android:textStyle="bold" />
        <!--交易额-->
        <androidx.appcompat.widget.AppCompatTextView
            style="@style/textStyle_title_14_zero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:gravity="right|center_vertical"
            android:maxLines="1"
            android:paddingLeft="@dimen/dp_8"
            android:text="--"
            app:autoSizeMaxTextSize="@dimen/sp_14"
            app:autoSizeMinTextSize="6sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform"
            tools:text="807.0008USDT" />

    </LinearLayout>
    <!--下单-->
    <com.yjkj.chainup.new_version.view.CommonlyUsedButton
        android:id="@+id/cbtn_create_order"
        android:layout_width="match_parent"
        app:bgClickColor="@android:color/transparent"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_12"
        app:bottonTextContent="@string/contract_action_buy" />


</LinearLayout>