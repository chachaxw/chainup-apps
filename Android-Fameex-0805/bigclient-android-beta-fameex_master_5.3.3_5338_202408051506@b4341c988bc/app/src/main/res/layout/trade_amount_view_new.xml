<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <!--买&卖-->
    <com.chainup.kit.views.KKTradeTabBarKit
        android:id="@+id/v_tb_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_30"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_coin_map"
        app:kk_tradeTabBar_selectColor1="@color/main_green"
        app:kk_tradeTabBar_selectColor2="@color/main_red"
        app:kk_tradeTabBar_text1="@string/contract_action_buy"
        app:kk_tradeTabBar_text2="@string/contract_action_sell"
        />
    <!--选择订单类型-->

    <com.chainup.kit.views.KKPopupSelectKit
        android:id="@+id/tv_order_type"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:paddingHorizontal="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_8"
        android:background="@drawable/bg_select_contract"
        app:kk_psk_width_equal_targetView="true"
        />

    <!--以当前最优价格交易-->
    <com.chainup.contract.view.trade.CpPriceTypeButton
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_32"
        android:visibility="gone"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_8"
        android:clickable="true"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true" />

    <com.coorchice.library.SuperTextView
        android:id="@+id/v_market_trade_tip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:gravity="center"
        android:paddingLeft="@dimen/dp_10"
        android:text="@string/common_tip_bestPriceTransaction"
        style="@style/textstyle_dm_14_color2"
        android:visibility="gone"
        app:stv_corner="@dimen/dp_4"
        app:stv_solid="@color/fill_5"
        app:stv_stroke_color="@color/fill_5"
        app:stv_stroke_width="@dimen/dp_half"
        tools:visibility="visible" />


    <!--价格-->
    <LinearLayout
        android:id="@+id/ll_price"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40"
        android:background="@drawable/bg_sp2_corners4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!--        <ImageView-->
<!--            android:id="@+id/tv_sub"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="40dp"-->
<!--            android:background="@color/transparent"-->
