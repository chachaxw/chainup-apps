<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fill_2"
    android:fitsSystemWindows="true"
    tools:context=".quickBuyCoin.QuickBuyCoinIndexActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.chainup.kit.views.PublicHeaderKit
            android:id="@+id/v_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            app:title="@string/creditCard_text0"
            app:rightBtnText="@string/order_records"
            app:isShowRightBtn="true"
            app:rightBtnType="text"
            app:rightBtnTextColor="@color/text_2"
            />

        <androidx.cardview.widget.CardView
            android:id="@+id/rl_flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginRight="@dimen/dp_16"
            app:cardBackgroundColor="@color/fill_3"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_14">

                <TextView
                    android:id="@+id/tv_zf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/creditCard_text1"
                    style="@style/textstyle_dm_14_color1"
                    />

                <EditText
                    android:id="@+id/tv_zf_num"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_zf"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginRight="15dp"
                    android:layout_toLeftOf="@+id/ll_rigth_fiat"
                    android:background="@null"
                    android:fontFamily="@font/dinpro_medium"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_color"
                    android:textColorHint="@color/text_3"
                    android:textSize="24sp"
                    android:clickable="true"
                    android:hint=""
                    android:maxLines="1"
                    android:ellipsize="end"
                    />

                <LinearLayout
                    android:id="@+id/ll_rigth_fiat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_fiat_pic"
                        android:layout_width="20dp"
                        android:layout_centerInParent="true"
                        android:layout_height="20dp"
                        />

                    <TextView
                        android:id="@+id/tv_fiat_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_8"
                        android:layout_marginRight="@dimen/dp_8"
                        android:text=""
                        style="@style/textstyle_dm_16_color1"
                        />

                    <ImageView
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:src="@drawable/public_arrow_right"
                        app:tint="@color/text_3"
                        />

                </LinearLayout>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_zf_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="5dp"
                android:text="单笔限额 200-3000 HKD"
                android:textSize="10sp"
                android:visibility="invisible"
                style="@style/textstyle_dr_10_color2"
                android:textColor="#EB4D5C"
                />

            <ImageView
                android:id="@+id/iv_transform"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:src="@drawable/contract_icon_morefunctions_fundstransfer"
                android:scaleType="fitCenter"
                android:layout_marginTop="@dimen/dp_22"
                android:layout_marginBottom="@dimen/dp_16"
                />
        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/rl_coin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            app:cardBackgroundColor="@color/fill_3"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/dp_16"
                android:paddingVertical="@dimen/dp_14">

                <TextView
                    android:id="@+id/tv_sd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/creditCard_text2"
                    style="@style/textstyle_dm_14_color1"
                    />

<!--                <TextView-->
<!--                    android:id="@+id/tv_sd_num"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_below="@+id/tv_sd"-->
<!--                    android:layout_marginTop="@dimen/dp_8"-->
<!--                    android:layout_toLeftOf="@+id/ll_rigth_coin"-->
<!--                    android:background="@null"-->
<!--                    android:fontFamily="@font/dinpro_medium"-->
<!--                    android:textColor="@color/text_color"-->
<!--                    android:textColorHint="@color/text_3"-->
<!--                    android:textSize="24sp"-->
<!--                    android:maxLines="1"-->
<!--                    android:ellipsize="end"-->

<!--                    />-->

                <EditText
                    android:id="@+id/tv_sd_num"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_sd"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginRight="15dp"
                    android:layout_toLeftOf="@+id/ll_rigth_coin"
                    android:background="@null"
                    android:fontFamily="@font/dinpro_medium"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_color"
                    android:textColorHint="@color/text_3"
                    android:textSize="24sp"
                    android:clickable="true"
                    android:hint=""
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:enabled="false"
                    />

                <LinearLayout
                    android:id="@+id/ll_rigth_coin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_coin_pic"
                        android:layout_width="20dp"
                        android:layout_centerInParent="true"
                        android:layout_height="20dp"
                        />

                    <TextView
                        android:id="@+id/tv_coin_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_8"
                        android:layout_marginRight="@dimen/dp_8"
                        android:text=""
                        style="@style/textstyle_dm_16_color1"
                        />

                    <ImageView
                        android:layout_width="@dimen/dp_16"
                        android:layout_height="@dimen/dp_16"
                        android:src="@drawable/public_arrow_right"
                        app:tint="@color/text_3"
                        />

                </LinearLayout>
            </RelativeLayout>

        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/tv_sd_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="5dp"
            android:text="单笔限额 200-3000 HKD"
            android:textColor="#EB4D5C"
            android:visibility="gone"
            android:textSize="10sp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_16">

            <LinearLayout
                android:id="@+id/ll_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/creditCard_text3"
                    style="@style/textstyle_dr_12_color2"
                    />

                <TextView
                    android:id="@+id/tv_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_buy_coin_text1"
                    style="@style/textstyle_dr_12_color2"
                    />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_avl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/ll_price"
                android:layout_marginTop="@dimen/dp_8"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_avl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/available_balance"
                    style="@style/textstyle_dr_12_color2"
                    />

                <TextView
                    android:id="@+id/tv_avl_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    style="@style/textstyle_dr_12_color2"
                    />

            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <com.chainup.kit.views.KKButtonKit
        android:id="@+id/cbtn_confirm"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_alignParentBottom="true"
        android:layout_gravity="bottom"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_30"
        app:kk_buttonText="@string/cl_lever_text4"
        />
</RelativeLayout>