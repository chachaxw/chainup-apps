<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card_color"
    android:paddingHorizontal="@dimen/dp_15"
    android:paddingTop="@dimen/dp_15">

    <TextView
        android:id="@+id/tv_title_pay_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/red"
        android:textSize="@dimen/sp_16"
        tools:text="Buy"
        style="@style/textStyle_dm"
        />

    <TextView
        android:id="@+id/tv_payment_coin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/tv_title_pay_type"
        android:textColor="@color/text_color"
        android:textSize="@dimen/sp_16"
        android:layout_marginLeft="@dimen/dp_5"
        tools:text="BTC"
        style="@style/textStyle_dm"
        />

    <TextView
        android:id="@+id/tv_pay_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/tv_payment_coin"
        android:layout_alignTop="@id/tv_payment_coin"
        android:layout_alignBottom="@id/tv_payment_coin"
        android:gravity="center_vertical"
        android:layout_marginLeft="@dimen/dp_6"
        android:textColor="@color/normal_text_color"
        android:textSize="@dimen/sp_12"
        tools:text="02/02 12:00"
        style="@style/textStyle_dr"
        />

    <ImageView
        android:id="@+id/iv_enter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:src="@drawable/enter"
        android:scaleType="fitCenter"
        android:layout_alignTop="@id/tv_status"
        android:layout_alignBottom="@id/tv_status"
        />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_10"
        android:layout_toLeftOf="@+id/iv_enter"
        android:textColor="@color/normal_text_color"
        android:textSize="@dimen/sp_12"
        tools:text="已完成"
        style="@style/textStyle_dr"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_title_pay_type"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_16"
        >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_price_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_buy_coin_text2"
                style="@style/orderStyle_title" />

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/orderStyle_value"
                android:layout_marginTop="@dimen/dp_9"
                tools:text="49494" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:orientation="vertical"
            >

            <TextView
                android:id="@+id/tv_otc_amount_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/quick_buy_coin_text3"
                style="@style/orderStyle_title"/>

            <TextView
                android:id="@+id/tv_otc_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/orderStyle_value"
                android:layout_marginTop="@dimen/dp_9"
                tools:text="494" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_total_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_buy_coin_text4"
                style="@style/orderStyle_title" />

            <TextView
                android:id="@+id/tv_total_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/orderStyle_value"
                android:layout_marginTop="@dimen/dp_9"
                tools:text="49494" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_half"
        android:background="@color/line_color"
        android:layout_alignParentBottom="true"
        />


</RelativeLayout>