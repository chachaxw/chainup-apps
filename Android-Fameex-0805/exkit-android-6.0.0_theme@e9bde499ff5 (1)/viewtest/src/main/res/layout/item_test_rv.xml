<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    xmlns:app="http://schemas.android.com/tools"
    android:gravity="center_vertical"
    xmlns:tool="http://schemas.android.com/apk/res-auto"
    app:ignore="NamespaceTypo">
    <RelativeLayout
        android:id="@+id/rl_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/dp_15"
        android:paddingRight="@dimen/dp_15">

     <LinearLayout
         android:layout_width="wrap_content"
         android:orientation="vertical"
         android:layout_centerVertical="true"
         android:layout_height="wrap_content">
         <LinearLayout
             android:id="@+id/ll_coin_name"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:orientation="horizontal">

             <TextView
                 android:id="@+id/tv_coin_name"
                 style="@style/textstyle_dm_16_color1"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="LTC" />

             <TextView
                 android:id="@+id/tv_market_name"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_marginStart="@dimen/dp_2"
                 style="@style/textstyle_dm_12_color2"
                 android:text="/ETH" />
         </LinearLayout>
         <!--24H交易量-->
         <LinearLayout
             android:layout_width="wrap_content"
             android:orientation="horizontal"
             android:gravity="center_vertical"
             android:layout_below="@+id/ll_coin_name"
             android:layout_height="wrap_content">
             <ImageView
                 android:id="@+id/img_market_collect"
                 android:layout_width="8dp"
                 android:layout_height="8dp"
                 android:visibility="gone"
                 android:layout_alignParentRight="true"
                 android:layout_centerVertical="true"
                 android:layout_marginRight="5dp"
                 android:src="@mipmap/public_favorites_small" />
             <TextView
                 android:id="@+id/tv_volume"
                 style="@style/textstyle_dr_12_color2"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:ellipsize="end"
                 android:maxLines="1"
                 android:text="24H量 0.0M"/>

         </LinearLayout>
     </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/tv_rose"
            android:layout_centerVertical="true"
            android:gravity="right"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_close_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_10"
                android:ellipsize="end"
                android:gravity="left"
                android:maxLines="1"
                android:singleLine="true"
                android:text="5734.580000" />

            <TextView
                android:id="@+id/tv_close_price_rmb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                style="@style/textstyle_dr_12_color2"
                android:text="¥3.14" />
        </LinearLayout>

        <com.coorchice.library.SuperTextView
            android:id="@+id/tv_rose"
            style="@style/textstyle_dm_14_color1"
            android:textColor="@color/white"
            android:layout_width="@dimen/dp_78"
            android:layout_height="@dimen/dp_32"
            android:layout_alignParentRight="true"
            android:layout_marginLeft="28dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lines="1"
            android:paddingLeft="@dimen/dp_2"
            android:paddingRight="@dimen/dp_2"
            android:textStyle="normal"
            app:stv_corner="@dimen/dp_4"
            app:stv_solid="@color/main_red"
            android:text="-16.68%" />
    </RelativeLayout>
</LinearLayout>