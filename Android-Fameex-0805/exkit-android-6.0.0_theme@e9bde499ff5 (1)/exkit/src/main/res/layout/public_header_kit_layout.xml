<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tool="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/public_ic_back"
        android:layout_width="wrap_content"
        android:visibility="visible"
        android:layout_marginLeft="@dimen/dp_8"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/img_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginLeft="@dimen/dp_16"
            android:scaleType="fitCenter"
            android:src="@mipmap/public_return" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/parent_filterView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/public_ic_back"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        >
        <RelativeLayout
            android:id="@+id/filterTitle"
            android:layout_width="wrap_content"
            android:visibility="gone"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/v_line"
                android:layout_width="@dimen/dp_1"
                android:layout_height="@dimen/dp_18"
                android:background="@color/fill_4"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/dp_8"
                android:visibility="visible"
                />
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tool:text="TextView"
                style="@style/textstyle_dm_18_color1"
                android:drawableLeft="@mipmap/trade_switchcurrency"
                android:drawableTint="@color/text_color_1"
                android:drawablePadding="@dimen/dp_8"
                android:layout_toRightOf="@id/v_line"
                android:layout_marginRight="8dp"
                />
        </RelativeLayout>

        <com.chainup.kit.views.KKTagKit
            android:id="@+id/chgTag"
            style="@style/textstyle_dm_12_color1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            app:kk_tag_title_text="-9.21%"
            app:kk_tag_type="rise" />
        <com.chainup.kit.views.KKTagKit
            android:id="@+id/typeTag"
            style="@style/textstyle_dm_12_color1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:kk_tag_title_text="Defi"
            app:kk_tag_type="defi" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="60dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/public_title_img"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/shape_point" />

        <TextView
            android:id="@+id/public_tx_content"
            style="@style/textstyle_dm_16_color1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="250dp"
            android:singleLine="true"
            android:text="TextView" />

        <ImageView
            android:id="@+id/public_title_down"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginLeft="12dp"
            android:src="@mipmap/public_icon_arrow_down" />

    </LinearLayout>


    <RelativeLayout
        android:id="@+id/sub_public_ic_btn2"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:paddingHorizontal="8dp"
        android:layout_toLeftOf="@id/sub_public_ic_btn"
        >
        <ImageView
            android:id="@+id/sub_rightBtnImgView2"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:scaleType="centerInside"
            android:src="@mipmap/public_icon_share"
            android:layout_centerInParent="true"
            />
        <TextView
            android:id="@+id/sub_rightBtnTextView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SubTextView"
            android:layout_centerInParent="true"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="@dimen/dp_100"
            android:visibility="visible"
            style="@style/textstyle_dm_14_color2"
            />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/sub_public_ic_btn"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:paddingHorizontal="8dp"
        android:layout_toLeftOf="@id/public_ic_btn"
        >
        <ImageView
            android:id="@+id/sub_rightBtnImgView"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:scaleType="centerInside"
            android:src="@mipmap/public_icon_share"
            android:layout_centerInParent="true"
            />
        <TextView
            android:id="@+id/sub_rightBtnTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SubTextView"
            android:layout_centerInParent="true"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="@dimen/dp_100"
            android:visibility="visible"
            style="@style/textstyle_dm_14_color2"
            />
    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/public_ic_btn"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:visibility="gone"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_marginRight="8dp"
        >
        <ImageView
            android:id="@+id/rightBtnImgView"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:scaleType="centerInside"
            android:src="@mipmap/public_notfavorited"
            android:layout_centerInParent="true"
            />
        <TextView
            android:id="@+id/rightBtnTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TextView"
            android:layout_centerInParent="true"
            android:singleLine="true"
            android:ellipsize="end"
            android:maxWidth="@dimen/dp_100"
            android:visibility="visible"
            style="@style/textstyle_dm_14_color2"
            />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/custom_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:visibility="gone"
        android:layout_marginRight="@dimen/dp_16"
        />

</RelativeLayout>