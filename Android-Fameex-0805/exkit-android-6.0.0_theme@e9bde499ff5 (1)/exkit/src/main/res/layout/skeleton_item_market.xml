<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    xmlns:app="http://schemas.android.com/tools"
    android:gravity="center_vertical"
    xmlns:tool="http://schemas.android.com/apk/res-auto"
    app:ignore="MissingDefaultResource,NamespaceTypo"
    android:paddingHorizontal="@dimen/dp_16">

    <View
        android:id="@+id/v_symbol"
        android:layout_width="91dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_skeleton_rectangle"
        tool:layout_constraintBottom_toBottomOf="parent"
        tool:layout_constraintStart_toStartOf="parent"
        tool:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="91dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_skeleton_rectangle"
        tool:layout_constraintBottom_toBottomOf="parent"
        tool:layout_constraintEnd_toStartOf="@id/v_rose"
        tool:layout_constraintStart_toEndOf="@id/v_symbol"
        tool:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_rose"
        android:layout_width="72dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_skeleton_rectangle"
        tool:layout_constraintBottom_toBottomOf="parent"
        tool:layout_constraintEnd_toEndOf="parent"
        tool:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>