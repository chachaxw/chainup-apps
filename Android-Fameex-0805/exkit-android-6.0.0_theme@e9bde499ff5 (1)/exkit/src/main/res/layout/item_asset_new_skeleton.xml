<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/tools"
    xmlns:tool="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    app:ignore="MissingDefaultResource,NamespaceTypo">


    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_86"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/layout_left_sk"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_skeleton_rectangle" />

        <View
            android:id="@+id/layout_se_two_f"
            android:layout_toRightOf="@id/layout_left_sk"
            android:layout_width="108dp"
            android:layout_height="20dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_skeleton_rectangle" />


        <View
            android:layout_toRightOf="@id/layout_left_sk"
            android:layout_width="101dp"
            android:layout_height="30dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_below="@id/layout_se_two_f"
            android:background="@drawable/bg_skeleton_rectangle" />



        <View
            android:id="@+id/layout_se_one_f"
            android:layout_width="125dp"
            android:layout_height="20dp"
            android:layout_alignParentRight="true"
            android:background="@drawable/bg_skeleton_rectangle" />


        <View
            android:layout_alignParentRight="true"
            android:layout_width="77dp"
            android:layout_height="30dp"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_below="@id/layout_se_one_f"
            android:background="@drawable/bg_skeleton_rectangle" />
    </RelativeLayout>


</LinearLayout>