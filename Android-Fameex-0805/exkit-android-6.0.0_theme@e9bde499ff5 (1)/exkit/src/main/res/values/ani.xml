        <item name="android:windowEnterAnimation">@anim/kk_ani_slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/kk_ani_slide_out_bottom</item>
    </style>
    <style name="ani_translate_from_top_to_bottom">
        <item name="android:windowEnterAnimation">@anim/kk_ani_slide_in_up</item>
        <item name="android:windowExitAnimation">@anim/kk_ani_slide_out_up</item>
    </style>

    <style name="ani_popwindow_center">
