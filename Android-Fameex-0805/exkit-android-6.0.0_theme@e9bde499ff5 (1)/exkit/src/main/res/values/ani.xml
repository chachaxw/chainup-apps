        <item name="android:windowExitAnimation">@anim/kk_ani_popwindow_pivot_center_exit</item>
    </style>

    <style name="ani_popwindow_top">
        <item name="android:windowEnterAnimation">@anim/kk_ani_popwindow_pivot_top_enter</item>
        <item name="android:windowExitAnimation">@anim/kk_ani_popwindow_pivot_top_exit</item>
    </style>

    <style name="ani_popwindow_top_right">
        <item name="android:windowEnterAnimation">@anim/kk_ani_popwindow_pivot_topright_enter</item>
        <item name="android:windowExitAnimation">@anim/kk_ani_popwindow_pivot_topright_exit</item>
