<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/v_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/card_bg_color_1"
    tools:ignore="MissingDefaultResource">
    <!--24H行情-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cly_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dp_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_coin_map"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            tools:text="XRP/USDT"
            style="@style/textstyle_dm_16_color1"
            />

        <TextView
            android:id="@+id/tv_close_price"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_10"
            android:gravity="center_vertical"
            android:textColor="@color/main_green"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:fontFamily="@font/dinpro_medium"
            app:layout_constraintLeft_toRightOf="@id/tv_coin_map"
            tools:text="4028.96" />

        <TextView
            android:id="@+id/cnPrice"
            style="@style/textstyle_dm_14_color2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="≈0000000287690.05CNY"
            app:layout_constraintBottom_toBottomOf="@+id/tv_close_price"
            app:layout_constraintStart_toEndOf="@+id/tv_close_price"
            app:layout_constraintTop_toTopOf="@+id/tv_close_price"
            android:layout_marginHorizontal="@dimen/dp_12"
            app:layout_constraintRight_toLeftOf="@id/tv_rose"
            />

        <TextView
            android:id="@+id/tv_rose"
            style="@style/textstyle_dm_14_color2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="@color/main_red"
            app:layout_constraintBottom_toBottomOf="@+id/tv_close_price"
            app:layout_constraintStart_toEndOf="@+id/cnPrice"
            app:layout_constraintTop_toTopOf="@+id/tv_close_price"
            tools:text="+1.88%"
            android:layout_marginLeft="@dimen/dp_12"
            />

        <TextView
            android:id="@+id/tv_converted_close_price"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_5"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:textColor="@color/normal_text_color"
            android:textSize="@dimen/sp_12"
            app:layout_constraintLeft_toRightOf="@id/tv_close_price"
            tools:text="≈287690.05CNY" />

        <!---->

        <TextView
            android:id="@+id/tv_rose_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/dp_5"
            android:gravity="center_vertical"
            android:text="@string/cp_extra_text110"
            android:visibility="gone"
            android:textColor="@color/normal_text_color"
            android:textSize="@dimen/sp_12"
            app:layout_constraintRight_toLeftOf="@id/tv_rose" />


        <TextView
            android:id="@+id/tv_high_price_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/dp_5"
            android:gravity="center_vertical"
            android:text="@string/cp_extra_text111"
            android:textColor="@color/normal_text_color"
            android:textSize="@dimen/sp_10"
            android:visibility="gone"
            app:layout_constraintRight_toLeftOf="@id/tv_high_price" />

        <TextView
            android:id="@+id/tv_high_price"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/dp_10"
            android:gravity="center_vertical"
            android:textColor="@color/text_color"
            android:textSize="@dimen/sp_10"
            android:fontFamily="@font/dinpro_medium"
            app:layout_constraintRight_toLeftOf="@id/tv_low_price_title"
            tools:text="3900.12"
            android:visibility="gone"
            />

        <TextView
            android:id="@+id/tv_low_price_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/dp_5"
            android:gravity="center_vertical"
            android:text="@string/cp_extra_text112"
            android:textColor="@color/normal_text_color"
            android:textSize="@dimen/sp_10"
            android:visibility="gone"
            app:layout_constraintRight_toLeftOf="@id/tv_low_price" />

        <TextView
            android:id="@+id/tv_low_price"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/dp_10"
            android:gravity="center_vertical"
            android:textColor="@color/text_color"
            android:textSize="@dimen/sp_10"
            android:fontFamily="@font/dinpro_medium"
            app:layout_constraintRight_toLeftOf="@id/tv_24h_title"
            tools:text="3900.12"
            android:visibility="gone"
            />

        <TextView
            android:id="@+id/tv_24h_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/dp_5"
            android:gravity="center_vertical"
            android:text="24H"
            android:textColor="@color/normal_text_color"
            android:textSize="@dimen/sp_10"
            android:visibility="gone"
            app:layout_constraintRight_toLeftOf="@id/tv_24h_vol" />

        <TextView
            android:id="@+id/tv_24h_vol"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:textColor="@color/text_color"
            android:textSize="@dimen/sp_10"
            android:fontFamily="@font/dinpro_medium"
            app:layout_constraintRight_toLeftOf="@id/iv_close"
            tools:text="16290"
            android:visibility="gone"
            />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:scaleType="fitCenter"
            android:layout_marginRight="@dimen/dp_28"
            android:src="@mipmap/public_icon_close"
            app:layout_constraintRight_toRightOf="parent"
            app:tint="@color/text_color_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <!--KLine-->
    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ll_index"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_kline_scale">

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/contract_kline_grid_line" />

        <FrameLayout
            android:id="@+id/exFlutter_kline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />

    </FrameLayout>


    <!--KLine时间轴-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_kline_scale"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_card_color"
        android:orientation="horizontal"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cly_header"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:listitem="@layout/cp_item_kline_scale_h"
        tools:itemCount="7"
        android:layout_marginRight="27.75dp"
        android:layout_marginLeft="@dimen/dp_16"
        />


    <!--KLine指标-->
    <LinearLayout
        android:id="@+id/ll_index"
        android:layout_width="@dimen/dp_55"
        android:layout_height="0dp"
        android:background="@drawable/bg_kline_grid_border"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_kline_scale"
        app:layout_constraintVertical_weight="1"
        android:layout_marginRight="27.75dp"
        android:layout_marginBottom="@dimen/dp_15">

        <TextView
            android:id="@+id/tv_main_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_8"
            android:text="@string/cp_extra_text155"
            android:textColor="@color/text_color_1"
            style="@style/textstyle_dr_12_color2"
            />

        <LinearLayout
            android:id="@+id/ll_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/cb_ma"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="MA"
                android:textColor="@drawable/cp_kline_index_text_selector"
                style="@style/textstyle_dr_12_color2"
                />
            <CheckBox
                android:id="@+id/cb_ema"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="EMA"
                android:textColor="@drawable/cp_kline_index_text_selector"
                style="@style/textstyle_dr_12_color2"
                />
            <CheckBox
                android:id="@+id/cb_boll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="BOLL"
                android:textColor="@drawable/cp_kline_index_text_selector"
                style="@style/textstyle_dr_12_color2"
                />


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_half"
            android:background="@color/contract_kline_grid_line" />
        <!--副图-->
        <TextView
            android:id="@+id/tv_vice_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/cp_extra_text156"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_8"
            android:textColor="@color/text_color_1"
            style="@style/textstyle_dr_12_color2"
            />

        <LinearLayout
            android:id="@+id/ll_vice"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:gravity="center"
            android:orientation="vertical">
            <CheckBox
                android:id="@+id/cb_vol"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="VOL"
                android:textColor="@drawable/cp_kline_index_text_selector"
                style="@style/textstyle_dr_12_color2"
                />
            <CheckBox
                android:id="@+id/cb_macd"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="MACD"
                android:textColor="@drawable/cp_kline_index_text_selector"
                style="@style/textstyle_dr_12_color2"
                />

            <CheckBox
                android:id="@+id/cb_kdj"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="KDJ"
                android:textColor="@drawable/cp_kline_index_text_selector"
                style="@style/textstyle_dr_12_color2"
                />

            <CheckBox
                android:id="@+id/cb_rsi"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="RSI"
                android:textColor="@drawable/cp_kline_index_text_selector"
                style="@style/textstyle_dr_12_color2"
                />

            <CheckBox
                android:id="@+id/cb_wr"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="WR"
                android:textColor="@drawable/cp_kline_index_text_selector"
                style="@style/textstyle_dr_12_color2"
                />

        </LinearLayout>

    </LinearLayout>


    <ImageView
        android:id="@+id/imageView"
        android:layout_width="@dimen/dp_half"
        android:layout_height="0dp"
        android:background="@color/contract_kline_grid_line"
        app:layout_constraintBottom_toBottomOf="@+id/frameLayout"
        app:layout_constraintEnd_toStartOf="@+id/frameLayout"
        app:layout_constraintTop_toBottomOf="@+id/rv_kline_scale" />
</androidx.constraintlayout.widget.ConstraintLayout>