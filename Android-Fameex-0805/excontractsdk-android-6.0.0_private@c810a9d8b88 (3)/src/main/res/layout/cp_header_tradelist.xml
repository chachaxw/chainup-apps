<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_card_color"
    android:layout_height="@dimen/dp_36">

    <ImageView
        android:id="@+id/switch_contract_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginLeft="@dimen/dp_16"
        android:scaleType="fitXY"
        android:src="@mipmap/trade_switch_close" />
    <TextView
        android:id="@+id/tv_onekey_close_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginLeft="@dimen/dp_8"
        android:text="@string/cl_close_1"
        style="@style/textstyle_dm_12_color2"
        android:layout_toRightOf="@id/switch_contract_type"
        />

    <com.coorchice.library.SuperTextView
        android:id="@+id/tv_onekey_close"
        style="@style/textstyle_dm_12_color1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_4"
        android:text="@string/cl_close_2"
        android:textFontWeight="500"
        app:stv_corner="@dimen/dp_2"
        app:stv_solid="@color/card_bg_color_2" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_alignParentBottom="true"
        android:background="@color/tabbar_divide_color"
        android:layout_height="0.5dp"/>

</RelativeLayout>