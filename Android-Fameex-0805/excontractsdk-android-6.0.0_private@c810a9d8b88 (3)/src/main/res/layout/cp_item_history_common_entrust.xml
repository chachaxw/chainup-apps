<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card_color"
    android:orientation="vertical"
  >

    <RelativeLayout
        android:paddingLeft="@dimen/dp_15"
        android:paddingRight="@dimen/dp_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12">

        <RelativeLayout
            android:id="@+id/ll_contract_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_side"
                style="@style/textstyle_dm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/dp_5"
                android:text="卖"
                android:textSize="@dimen/sp_16"
                tools:textColor="@color/main_red" />

            <TextView
                android:id="@+id/tv_coin_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="LTC/USDT"
                style="@style/textstyle_dm_16_color1"
                android:layout_toRightOf="@id/tv_side"
                />


            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                >
                <TextView
                    android:id="@+id/tv_status_go"
                    style="@style/textstyle_dm_14_color2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:text="已完成"

                    />

                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@mipmap/icon_right_arrow"
                    android:layout_toRightOf="@id/tv_status_go"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"
                    />
            </RelativeLayout>


        </RelativeLayout>

        <LinearLayout
            android:id="@+id/ll_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_contract_info"
            android:layout_marginTop="@dimen/dp_4"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_date"
                style="@style/textstyle_dr_12_color2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="2017-10-10 18:18" />

            <com.coorchice.library.SuperTextView
                android:id="@+id/tv_only_reduce_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingVertical="@dimen/dp_1"
                android:layout_marginLeft="@dimen/dp_5"
                android:text="只减仓"
                android:textColor="@color/main_color"
                android:textSize="@dimen/sp_10"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_order_type"
                app:stv_corner="@dimen/dp_2"
                app:stv_solid="@color/main_blue_15"
                style="@style/textstyle_dm_10_color1"
                android:visibility="gone"
                />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_liquidation"
            style="@style/textstyle_dm_14_color1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_date"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:text="Liquidation" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/dp_15"
        android:paddingRight="@dimen/dp_15"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/dp_8">

        <!--强平价格-->
        <LinearLayout
            android:id="@+id/ll_liq"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical|left"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dp_8"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_liq_price_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/cp_calculator_text20"
                style="@style/textstyle_dr_12_color2"
                />

            <TextView
                android:id="@+id/tv_liq_price"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="0.00"
                android:gravity="end"
                style="@style/textstyle_dm_14_color1"
                />

        </LinearLayout>


        <!--价格-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical|left"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dp_8"
            >

            <TextView
                android:id="@+id/tv_price_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/cp_order_text79"
                style="@style/textstyle_dr_12_color2"
                />

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"

                android:ellipsize="end"
                android:singleLine="true"
                android:text="0.00 /Market"
                android:gravity="end"
                style="@style/textstyle_dm_14_color1"
                />

        </LinearLayout>

        <!--数量-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dp_8"
            >

            <TextView
                android:id="@+id/tv_entrust_amount_key"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="start"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="委托数量(张)"
                style="@style/textstyle_dr_12_color2"
                />

            <TextView
                android:id="@+id/tv_amount"
                style="@style/textstyle_dm_14_color1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:singleLine="true"
                android:text="7.12 / 3654" />

        </LinearLayout>

        <!--实际成交量-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|right"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dp_8"
            >

            <TextView
                android:id="@+id/tv_pl_key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="盈亏(USDT)"
                style="@style/textstyle_dr_12_color2"
                />

            <TextView
                android:id="@+id/tv_pl"
                style="@style/textstyle_dm_14_color1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:gravity="end"
                android:text="--" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/dp_15"
        android:paddingRight="@dimen/dp_15"
        android:orientation="vertical">
        <!--价格-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="@dimen/dp_8"
            >

            <TextView
                android:id="@+id/tv_cp_order_text81"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/cp_order_text81"
                style="@style/textstyle_dr_12_color2"
                />

            <TextView
                android:id="@+id/tv_deal_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="0.014450"
                android:layout_weight="1"
                android:gravity="end"
                style="@style/textstyle_dm_14_color1"
                />

        </LinearLayout>


        <!--数量-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="@dimen/dp_8"
            >

            <TextView
                android:id="@+id/tv_deal_amount_key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/cp_extra_text8"
                style="@style/textstyle_dr_12_color2"
                />

            <TextView
                android:id="@+id/tv_deal_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="0.014450"
                style="@style/textstyle_dm_14_color1"

                />

        </LinearLayout>

        <!--实际成交量-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_16"
            >

            <TextView
                android:id="@+id/tv_cp_order_text93"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/cp_order_text93"
                style="@style/textstyle_dr_12_color2"
                />

            <TextView
                android:id="@+id/tv_order_type"
                style="@style/textstyle_dm_14_color1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="--"
                android:gravity="end"
                />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_half"
        android:background="@color/line_color"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        />

</LinearLayout>