<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cp_bg_item_dialog_bg"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:id="@+id/tv_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginRight="@dimen/dp_20"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/dp_6"
            tools:text=""
            style="@style/textstyle_dm_16_color1"
            />
    </LinearLayout>

    <com.coorchice.library.SuperTextView
        android:id="@+id/tv_confirm_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_below="@+id/tv_content_layout"
        android:layout_marginHorizontal="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_25"
        android:layout_marginBottom="@dimen/dp_20"
        android:gravity="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:text="我知道了"
        app:stv_solid="@color/main_color"
        app:stv_corner="@dimen/dp_4"
        style="@style/textstyle_dm_14_color1"
        />
</RelativeLayout>
