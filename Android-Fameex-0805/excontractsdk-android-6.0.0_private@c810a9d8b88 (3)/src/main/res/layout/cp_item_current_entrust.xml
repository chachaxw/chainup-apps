<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card_color"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_16">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16">

        <TextView
            android:id="@+id/tv_side"
            style="@style/textstyle_dm"
            android:layout_width="@dimen/dp_44"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:ellipsize="middle"
            android:gravity="center"
            android:maxLines="2"
            android:text="卖"
            android:textSize="@dimen/sp_14"
            tools:textColor="@color/main_red" />

        <LinearLayout
            android:id="@+id/ll_contract_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toRightOf="@id/tv_side"
            android:layout_marginLeft="@dimen/dp_8"
            >

            <TextView
                android:id="@+id/tv_coin_name"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@id/tv_side"
                android:text="LTC/USDT"
                style="@style/textstyle_dm_16_color1"
                />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/dp_5"
                >
                <com.coorchice.library.SuperTextView
                    android:id="@+id/tv_order_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:text="Maker"
                    style="@style/contract_tag_style"

                    />
                <com.coorchice.library.SuperTextView
                    android:id="@+id/tv_only_reduce_position"
                    android:layout_marginLeft="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:text="@string/cp_order_text54"
                    style="@style/contract_tag_style"
                    />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_date"
            style="@style/textstyle_dr_12_color2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="@dimen/dp_2"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="2017-10-10 18:18" />

    </RelativeLayout>



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_17"
        >

        <com.chainup.contract.view.trade.CircleProgressView
            android:id="@+id/mDeal_volume"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            app:location_start="top"
            android:layout_centerVertical="true"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/tv_cancel"
            android:layout_toRightOf="@id/mDeal_volume"
            android:layout_marginHorizontal="@dimen/dp_8"
            android:orientation="vertical">

<!--            数量-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_quantity_title"
                    android:layout_width="@dimen/dp_80"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/cp_calculator_text10"
                    style="@style/textstyle_dr_12_color2"
                    />

                <TextView
                    android:id="@+id/tv_quantity"
                    style="@style/textstyle_dm_14_bold_color1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="--/--" />

            </LinearLayout>

            <!--价格-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/dp_10">
                <TextView
                    android:id="@+id/tv_price_title"
                    android:layout_width="@dimen/dp_80"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/cp_overview_text6"
                    style="@style/textstyle_dr_12_color2"
                    />

                <TextView
                    android:id="@+id/tv_price"
                    style="@style/textstyle_dm_14_bold_color1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="0.014450" />

            </LinearLayout>


            <!--avg price-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_10"
                android:orientation="horizontal"
                android:visibility="gone"
                >

                <TextView
                    android:id="@+id/tv_volume_title"
                    android:layout_width="@dimen/dp_80"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/cp_order_text81"
                    style="@style/textstyle_dr_12_color2"
                    />

                <TextView
                    android:id="@+id/tv_volume"
                    style="@style/textstyle_dm_14_bold_color1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="0.014450" />

            </LinearLayout>


            <!--tp/sl-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_10"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_deal_title"
                    android:layout_width="@dimen/dp_80"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/cp_overview_text12"
                    style="@style/textstyle_dr_12_color2"
                    />

                <TextView
                    android:id="@+id/tv_deal"
                    style="@style/textstyle_dm_14_bold_color1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="--/--" />

            </LinearLayout>

        </LinearLayout>

        <com.coorchice.library.SuperTextView
            android:id="@+id/tv_cancel"
            android:layout_width="@dimen/dp_75"
            android:layout_height="@dimen/dp_34"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:ellipsize="end"
            android:gravity="center"
            android:text="@string/cp_order_text68"
            style="@style/textstyle_dm_14_color1"
            app:stv_corner="@dimen/dp_4"
            app:stv_solid="@color/card_bg_color_2"

            />

    </RelativeLayout>

    <RelativeLayout
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:paddingLeft="@dimen/dp_15"
        android:paddingRight="@dimen/dp_15"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_dealvolume_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="成交数量(张)"
            android:textColor="@color/normal_text_color"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tv_totalvolume_key"
            android:textSize="12sp"
            android:textColor="@color/normal_text_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:layout_alignParentRight="true"
            android:text="委托数量(张)" />

    </RelativeLayout>
    <ProgressBar
        android:visibility="gone"
        android:id="@+id/pb_deal_volume"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_width="match_parent"

        android:progress="10"
        android:paddingLeft="@dimen/dp_15"
        android:paddingRight="@dimen/dp_15"
        android:progressTint="@color/main_blue"
        android:progressBackgroundTint="@color/card_bg_color_2"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_height="5dp"/>
    <RelativeLayout
        android:visibility="gone"
        android:layout_marginBottom="12dp"
        android:paddingLeft="@dimen/dp_15"
        android:paddingRight="@dimen/dp_15"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_dealvolume"
            style="@style/textStyle_value_82_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="17(58%)"
            android:textColor="@color/text_color"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_totalvolume"
            style="@style/textStyle_value_82_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="32"
            android:textColor="@color/text_color"
            android:textSize="14sp" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_half"
        android:background="@color/line_color" />

</LinearLayout>