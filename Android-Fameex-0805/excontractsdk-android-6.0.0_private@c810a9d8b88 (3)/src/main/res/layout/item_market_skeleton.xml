<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    xmlns:app="http://schemas.android.com/tools"
    android:gravity="center_vertical"
    xmlns:tool="http://schemas.android.com/apk/res-auto"
    app:ignore="MissingDefaultResource,NamespaceTypo">
    <RelativeLayout
        android:id="@+id/rl_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/ll_coin_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:background="@drawable/bg_skeleton_rectangle"
                    android:layout_width="70dp"
                    android:layout_height="15dp"/>
                <View
                    android:background="@drawable/bg_skeleton_rectangle"
                    android:layout_width="30dp"
                    android:layout_marginLeft="10dp"
                    android:layout_height="15dp"/>
            </LinearLayout>
            <!--24H交易量-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/ll_coin_name"
                android:layout_height="wrap_content">
                <View
                    android:background="@drawable/bg_skeleton_rectangle"
                    android:layout_width="50dp"
                    android:layout_height="15dp"/>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/v_rose"
            android:layout_centerVertical="true"
            android:gravity="right"
            android:orientation="vertical">

            <View
                android:background="@drawable/bg_skeleton_rectangle"
                android:layout_width="70dp"
                android:layout_height="15dp"/>

            <View
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_skeleton_rectangle"
                android:layout_width="50dp"
                android:layout_height="15dp"/>
        </LinearLayout>

        <View
            android:id="@+id/v_rose"
            android:background="@drawable/bg_skeleton_rectangle"
            android:layout_width="78dp"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:layout_marginLeft="28dp"
            android:layout_height="32dp"/>

    </RelativeLayout>
</LinearLayout>