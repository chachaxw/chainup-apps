<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card_color"
    android:orientation="vertical"
 >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/dp_15"
        android:paddingRight="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_12">

        <LinearLayout
            android:id="@+id/ll_contract_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_side"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/dp_5"
                android:text="卖"
                tools:textColor="@color/main_red"
                style="@style/textstyle_dm_16_color1"
                />

            <TextView
                android:id="@+id/tv_coin_name"
                style="@style/textstyle_dm_16_color1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@id/tv_side"
                android:text="LTC/USDT"

                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_contract_info"
            android:layout_marginTop="@dimen/dp_4"
            android:orientation="horizontal">

            <com.coorchice.library.SuperTextView
                android:id="@+id/tv_level_value"
                style="@style/contract_tag_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginRight="@dimen/dp_5"
                android:layout_toRightOf="@+id/tv_contract_name"
                android:text="逐仓20X"
                />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_date"
            style="@style/textstyle_dr_12_color2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="2017-10-10 18:18"
            android:layout_alignParentRight="true"
            android:layout_marginTop="@dimen/dp_5"
            />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_14"
        android:paddingHorizontal="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:orientation="vertical">
        <!--价格-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/dp_8"
            android:gravity="center_vertical"
            >

            <TextView
                android:id="@+id/tv_settled_profit_loss_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cp_order_text99"
                style="@style/textstyle_dr_12_color2"
                android:paddingBottom="@dimen/dp_2"
                android:layout_gravity="start"
                android:background="@drawable/dotted_line"
                />

            <TextView
                android:id="@+id/tv_pl_price"
                style="@style/textstyle_dm_14_color1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="0.014450"
                android:gravity="end" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="@dimen/dp_8"
            >

            <TextView
                android:id="@+id/tv_cp_order_text7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/cp_order_text7"
                style="@style/textstyle_dr_12_color2"
                android:layout_gravity="center_vertical"
                />

            <TextView
                android:id="@+id/tv_open_average_price"
                style="@style/textstyle_dm_14_color1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:gravity="end"
                android:text="0.014450" />

        </LinearLayout>

        <!--实际成交量-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            >

            <TextView
                android:id="@+id/tv_position_amount_key"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="仓位数量(张)"
                style="@style/textstyle_dr_12_color2"
                android:layout_gravity="center_vertical"
                />

            <TextView
                android:id="@+id/tv_position_amount"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="--"
                android:gravity="end"
                style="@style/textstyle_dm_14_color1"
                />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_half"
        android:background="@color/line_color"
        android:layout_marginLeft="@dimen/dp_16"
        />

</LinearLayout>