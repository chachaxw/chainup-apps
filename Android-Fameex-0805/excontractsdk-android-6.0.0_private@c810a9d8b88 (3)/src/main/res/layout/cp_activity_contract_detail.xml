<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card_color"
    android:orientation="vertical">

    <com.chainup.kit.views.PublicHeaderKit
        android:id="@+id/mHeaderKit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        app:filterTitleVisible="true"

        />


    <com.flyco.tablayout.SlidingTabLayout
        android:id="@+id/sub_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        style="@style/contract_slidinglayout_style"
        app:tl_textSelectSize="@dimen/sp_16"
        app:tl_textUnSelectSize="@dimen/sp_16"
        />
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/line_color"
        />

    <com.chainup.contract.view.CpNoScrollViewPager
        android:id="@+id/vp_order"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        />

</LinearLayout>

