<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#50000000"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_card_color"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_16"
        >
        <TextView
            android:id="@+id/tv_set_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cp_contract_kline_set_title"
            app:layout_constraintLeft_toLeftOf="parent"
            style="@style/textstyle_dm_12_color2"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tv_cp_extra_text155"
            />

        <TextView
            android:id="@+id/tv_cp_extra_text155"
            style="@style/textstyle_dm_12_color1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cp_extra_text155"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintRight_toLeftOf="@id/rv_kline_ctrl_main"
            app:layout_constraintTop_toBottomOf="@id/tv_set_title"
            android:layout_marginTop="@dimen/dp_12"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:background="@color/bg_card_color"
            android:id="@+id/rv_kline_ctrl_main"
            android:layout_width="0dp"
            tools:itemCount="8"
            tools:listitem="@layout/cp_item_kline_ctrl_more"
            app:layout_constraintRight_toRightOf="parent"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toRightOf="@id/tv_cp_extra_text155"
            android:layout_marginLeft="@dimen/dp_12"
            app:layout_constraintTop_toBottomOf="@id/tv_set_title"
            android:layout_marginTop="@dimen/dp_12"
            />


        <TextView
            android:id="@+id/tv_cp_extra_text156"
            style="@style/textstyle_dm_12_color1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cp_extra_text156"
            app:layout_constraintStart_toStartOf="@+id/tv_cp_extra_text155"
            app:layout_constraintTop_toTopOf="@+id/rv_kline_ctrl_vice" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_kline_ctrl_vice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/bg_card_color"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintEnd_toEndOf="@+id/rv_kline_ctrl_main"
            app:layout_constraintRight_toRightOf="@id/rv_kline_ctrl_main"
            app:layout_constraintStart_toStartOf="@+id/rv_kline_ctrl_main"
            app:layout_constraintTop_toBottomOf="@+id/rv_kline_ctrl_main"
            tools:itemCount="8"
            tools:listitem="@layout/cp_item_kline_ctrl_more"
            android:layout_marginTop="@dimen/dp_16"
            />

        <View
            android:id="@+id/line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line_color"
            app:layout_constraintTop_toBottomOf="@id/rv_kline_ctrl_vice"
            android:layout_marginTop="@dimen/dp_16"

            />

        <TextView
            android:id="@+id/tv_orderDisplayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cp_contract_order_display"
            app:layout_constraintLeft_toLeftOf="parent"
            style="@style/textstyle_dm_12_color2"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintTop_toBottomOf="@id/line"
            />


        <LinearLayout
            android:id="@+id/ll_toggle_order_visible"
            android:layout_width="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/dp_14"
            android:layout_marginBottom="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_orderDisplayTitle"
            app:layout_constraintTop_toBottomOf="@id/tv_orderDisplayTitle"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_check"
                android:src="@drawable/optional_checkbox_selected_selector"
                android:layout_width="@dimen/dp_12"
                android:layout_height="@dimen/dp_12"
                android:layout_gravity="center"
                />
            <TextView
                android:id="@+id/tv_order_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cp_contract_order_history"
                android:layout_marginLeft="@dimen/dp_8"
                style="@style/textstyle_dm_12_color1"
                />
        </LinearLayout>

