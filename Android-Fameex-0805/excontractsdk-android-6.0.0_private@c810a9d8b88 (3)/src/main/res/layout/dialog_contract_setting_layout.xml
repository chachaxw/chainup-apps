<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingHorizontal="@dimen/dp_16"
    android:background="@drawable/bg_contract_setting">
    <RelativeLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/dp_14"
        >

        <TextView
            android:id="@+id/ct_title"
            style="@style/textstyle_dm_16_color1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cp_contract_setting_title" />

        <ImageView
            android:id="@+id/ct_close"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:layout_alignParentRight="true"
            android:src="@drawable/cp_ic_baseline_close_24"
            app:tint="@color/text_color_1"
            />

    </RelativeLayout>


    <com.chainup.contract.view.CpGridRecyclerView
        android:id="@+id/mStRv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:listitem="@layout/item_rv_contract_setting"
        app:layout_constraintTop_toBottomOf="@id/title_layout"
        android:minHeight="@dimen/dp_30"
        android:layout_marginTop="@dimen/dp_8"
        />

    <LinearLayout
        android:id="@+id/add_optional"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_32"
        app:layout_constraintTop_toBottomOf="@id/mStRv"
        android:layout_marginTop="@dimen/dp_16"
        android:background="@drawable/bg_select_contract"
        android:paddingLeft="@dimen/dp_11"
        android:layout_marginBottom="@dimen/dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        >
        <ImageView
            android:id="@+id/ic_optional"
            android:layout_width="@dimen/dp_15"
            android:layout_height="@dimen/dp_15"
            android:src="@drawable/ic_public_favorites_small"
            android:layout_gravity="center_vertical"
            android:scaleType="fitXY"
            />
        <TextView
            android:id="@+id/tv_optional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cp_contract_add_optional_symbol"
            style="@style/textstyle_dm_12_color1"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_gravity="center_vertical"
            />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>