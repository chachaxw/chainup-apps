<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/cp_bg_item_dialog_bg"
    android:paddingVertical="@dimen/dp_20"
    >
        <ImageView
            android:id="@+id/iv_icon_tip"
            android:layout_width="@dimen/dp_80"
            android:layout_height="@dimen/dp_80"
            android:src="@mipmap/public_prompt"
            android:visibility="gone"
            tools:visibility="visible"
            android:scaleType="fitCenter"
            android:layout_centerHorizontal="true"

            />

        <LinearLayout
            android:id="@+id/tv_content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_icon_tip"
            android:layout_marginTop="@dimen/dp_8"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/textstyle_dm_16_color1"
                tools:text="止盈止损单风险须知"
                android:visibility="visible"
                android:gravity="center"
                />

            <TextView
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_20"
                android:lineSpacingExtra="3dp"
                tools:text="“止盈止损”订单是指，预先设置“触发价”，“委托价”和“下单数量”，最新价达到触发价，会按委托价挂单，帮助您保住利润或减少损失。"
                style="@style/textstyle_dr_14_color2"
                android:gravity="center"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginLeft="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_20"
            android:layout_below="@+id/tv_content_layout"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tv_cancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_44"
                android:layout_below="@+id/tv_content_layout"
                android:layout_centerHorizontal="true"
                android:layout_marginRight="@dimen/dp_16"
                android:background="@drawable/kk_btn_2_bg"
                android:text="取消"
                android:textAllCaps="false"
                android:textStyle="bold"
                style="@style/textstyle_dm_14_color1"
                />

            <Button
                android:id="@+id/tv_confirm_btn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_44"
                android:layout_below="@+id/tv_content_layout"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_select_button_blue"
                android:text="确认"
                android:textAllCaps="false"
                android:textStyle="bold"
                style="@style/textstyle_dm_14_color1"
                android:textColor="@color/white"
                />

        </LinearLayout>

</RelativeLayout>
