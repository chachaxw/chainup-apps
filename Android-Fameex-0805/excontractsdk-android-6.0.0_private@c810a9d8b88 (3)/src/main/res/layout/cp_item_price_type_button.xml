<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_select_contract"
    android:descendantFocusability="blocksDescendants"
    android:paddingLeft="@dimen/dp_10"
    android:paddingRight="@dimen/dp_10"
    android:clickable="true"
    android:id="@+id/pid"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ic_tip"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:src="@mipmap/public_instructions"
        android:layout_centerVertical="true"
        android:visibility="gone"
        tools:visibility="visible"
        android:scaleType="fitXY"
        />

    <TextView
        android:id="@+id/tv_trade_order_type"
        style="@style/textstyle_dm_14_bold_color1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginRight="@dimen/dp_30"
        android:clickable="false"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/cp_overview_text3" />

    <ImageView
        android:id="@+id/tv_tag"
        android:layout_width="@dimen/dp_8"
        android:layout_height="@dimen/dp_8"
        android:clickable="false"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true"
        android:src="@mipmap/public_icon_arrow_down" />


</RelativeLayout>