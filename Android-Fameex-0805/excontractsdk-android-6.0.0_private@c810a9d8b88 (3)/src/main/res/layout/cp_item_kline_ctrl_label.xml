<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingRight="@dimen/dp_20"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        >
        <TextView
            android:id="@+id/tv_scale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"

            tools:text="30"
            style="@style/textstyle_dm_12_color1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <ImageView
            android:id="@+id/ic_arrow"
            android:layout_width="@dimen/dp_8"
            android:layout_height="@dimen/dp_6"
            android:layout_marginLeft="@dimen/dp_5"
            android:scaleType="fitCenter"
            android:src="@mipmap/public_icon_arrow_down"
            app:layout_constraintBottom_toBottomOf="@id/tv_scale"
            app:layout_constraintLeft_toRightOf="@id/tv_scale"
            app:layout_constraintTop_toTopOf="@+id/tv_scale"
            app:tint="@color/text_color_2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

     <ImageView
         android:id="@+id/tv_line"
         android:layout_width="20dp"
         android:visibility="gone"
         android:layout_centerHorizontal="true"
         android:layout_alignParentBottom="true"
         android:background="@color/main_blue"
         android:layout_height="2dp"/>
</RelativeLayout>