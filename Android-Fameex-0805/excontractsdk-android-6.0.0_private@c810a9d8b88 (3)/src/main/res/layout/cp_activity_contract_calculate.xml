<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card_color"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <com.chainup.kit.views.PublicHeaderKit
            android:id="@+id/mHeaderKit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            app:filterTitleVisible="true"
            />

        <LinearLayout
            android:id="@+id/ll_position"
            android:layout_width="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:background="@drawable/bg_select_contract"
            android:paddingHorizontal="@dimen/dp_12"
            android:layout_alignParentRight="true"
            android:layout_height="@dimen/dp_24"
            android:layout_marginRight="@dimen/dp_16"
            >
            <TextView
                android:id="@+id/tv_position"
                android:layout_centerVertical="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/cp_contract_setting_text1"
                style="@style/textstyle_dm_14_color1"
                android:layout_marginRight="@dimen/dp_14"
                />
            <ImageView
                android:id="@+id/img_position"
                android:layout_width="@dimen/dp_8"
                android:src="@mipmap/public_icon_arrow_down"
                android:layout_height="@dimen/dp_8"
                android:scaleType="fitCenter"
                />

        </LinearLayout>

    </RelativeLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">

        <com.flyco.tablayout.SlidingTabLayout
            android:id="@+id/sub_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            style="@style/contract_slidinglayout_style"
            app:tl_textSelectSize="@dimen/sp_16"
            app:tl_textUnSelectSize="@dimen/sp_16"
            />
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/line_color"
            />

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/vp_order"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />
    </LinearLayout>

</LinearLayout>

